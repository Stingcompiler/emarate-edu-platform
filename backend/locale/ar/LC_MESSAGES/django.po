msgid "Invalid phone number."
msgstr "رقم هاتف غير صالح."

msgid "Give an email or a phone number."
msgstr "أدخل بريدًا إلكترونيًا أو رقم هاتف."

msgid "This inquiry is routed to someone else."
msgstr "هذا الاستفسار محوَّل إلى شخص آخر."

#, python-format
msgid "Cannot move from %(status)s to %(to)s."
msgstr "لا يمكن النقل من %(status)s إلى %(to)s."

msgid "Reply by email or add an internal note."
msgstr "ردّ بالبريد أو أضف ملاحظة داخلية."

msgid "This visitor has no email; use WhatsApp."
msgstr "لا بريد لهذا الزائر؛ استخدم واتساب."

msgid "This visitor has no phone number."
msgstr "لا رقم هاتف لهذا الزائر."

msgid "This person does not handle this kind of inquiry."
msgstr "هذا الشخص لا يتولى هذا النوع من الاستفسارات."

msgid "Use {\"rules\": [...]}."
msgstr "استخدم {\"rules\": [...]}."

msgid "Must be after the due date."
msgstr "يجب أن يكون بعد موعد التسليم."

msgid "Must be before the due date."
msgstr "يجب أن يكون قبل موعد التسليم."

msgid "Pick a lecture of the same course."
msgstr "اختر محاضرة من المادة نفسها."

msgid "You cannot delete this lecture."
msgstr "لا يمكنك حذف هذه المحاضرة."

msgid "A file resource needs exactly one uploaded file."
msgstr "مورد الملف يحتاج ملفًا مرفوعًا واحدًا بالضبط."

msgid "Upload the file to this course first."
msgstr "ارفع الملف إلى هذه المادة أولًا."

msgid "A video resource needs exactly one video."
msgstr "مورد الفيديو يحتاج فيديو واحدًا بالضبط."

msgid "Upload the video to this course first."
msgstr "ارفع الفيديو إلى هذه المادة أولًا."

msgid "A link resource needs a URL."
msgstr "مورد الرابط يحتاج عنوان URL."

#, python-format
msgid "Invalid pattern: %(pattern)s"
msgstr "نمط غير صالح: %(pattern)s"

msgid "Choose how students submit first."
msgstr "اختر طريقة تسليم الطلاب أولًا."

msgid "You cannot delete this assignment."
msgstr "لا يمكنك حذف هذا الواجب."

msgid "Students have submitted; close the assignment instead."
msgstr "سلّم الطلاب؛ أغلق الواجب بدلًا من حذفه."

msgid "Submissions have not opened yet."
msgstr "لم يُفتح التسليم بعد."

msgid "The deadline has passed."
msgstr "انتهى موعد التسليم."

msgid "The late window has closed."
msgstr "انتهت مهلة التسليم المتأخر."

#, python-format
msgid "At most %(max_files)s files."
msgstr "الحد الأقصى %(max_files)s ملفات."

msgid "Upload each file to this course first."
msgstr "ارفع كل ملف إلى هذه المادة أولًا."

#, python-format
msgid "%(name)s: type not accepted here."
msgstr "%(name)s: نوع غير مقبول هنا."

#, python-format
msgid "%(name)s: larger than %(max_file_size_mb)s MB."
msgstr "%(name)s: أكبر من %(max_file_size_mb)s ميغابايت."

#, python-format
msgid "%(label)s: required."
msgstr "%(label)s: مطلوب."

#, python-format
msgid "%(label)s: must start with http:// or https://."
msgstr "%(label)s: يجب أن يبدأ بـ http:// أو https://."

#, python-format
msgid "%(label)s: does not match the expected format."
msgstr "%(label)s: لا يطابق الصيغة المطلوبة."

#, python-format
msgid "Unknown link: %(value)s"
msgstr "رابط غير معروف: %(value)s"

msgid "This assignment is not accepting submissions."
msgstr "هذا الواجب لا يستقبل تسليمات."

msgid "Text answers are not accepted here."
msgstr "الإجابات النصية غير مقبولة هنا."

msgid "Files are not accepted here."
msgstr "الملفات غير مقبولة هنا."

msgid "Links are not accepted here."
msgstr "الروابط غير مقبولة هنا."

msgid "The submission is empty."
msgstr "التسليم فارغ."

msgid "Submitted twice at once; try again."
msgstr "أُرسل التسليم مرتين في اللحظة نفسها؛ أعد المحاولة."

msgid "Resubmission is not allowed."
msgstr "إعادة التسليم غير مسموحة."

msgid "This submission is already graded."
msgstr "صُحّح هذا التسليم بالفعل."

#, python-format
msgid "Between 0 and %(max_grade)s."
msgstr "بين 0 و%(max_grade)s."

msgid "There is no suggested grade to approve."
msgstr "لا توجد درجة مقترحة لاعتمادها."

msgid "Only the teacher approves AI-suggested grades."
msgstr "لا يعتمد الدرجات المقترحة آليًا إلا الأستاذ."

msgid "Choose the program and level."
msgstr "اختر البرنامج والمستوى."

msgid "You cannot schedule sessions for this course or cohort."
msgstr "لا يمكنك جدولة جلسات لهذه المادة أو الدفعة."

msgid "Use the https:// meeting link."
msgstr "استخدم رابط الاجتماع https://."

msgid "Add the meeting link."
msgstr "أضف رابط الاجتماع."

msgid "This session was cancelled."
msgstr "أُلغيت هذه الجلسة."

msgid "The link opens 15 minutes before the start."
msgstr "يُفتح الرابط قبل البداية بـ 15 دقيقة."

#, python-format
msgid "type must be one of %(sorted)s."
msgstr "النوع يجب أن يكون أحد: %(sorted)s."

msgid "ids: a non-empty list of numbers."
msgstr "ids: قائمة أرقام غير فارغة."

msgid "ids: a non-empty list of user ids."
msgstr "ids: قائمة غير فارغة بمعرّفات المستخدمين."

#, python-format
msgid "members must be one of %(sorted)s."
msgstr "الأعضاء يجب أن يكونوا أحد: %(sorted)s."

msgid "level must be between 1 and 10."
msgstr "المستوى يجب أن يكون بين 1 و10."

msgid "roles: a non-empty list of roles."
msgstr "roles: قائمة أدوار غير فارغة."

msgid "This audience is outside what you may notify."
msgstr "هذا الجمهور خارج ما يحق لك إشعاره."

msgid "Use a portal path (/...) or an https:// link."
msgstr "استخدم مسارًا في البوابة (/...) أو رابط https://."

msgid "Push endpoints are https URLs."
msgstr "عناوين Push يجب أن تكون https."

#, python-format
msgid "Choose from %(values)s."
msgstr "اختر من: %(values)s."

msgid "Choose a teacher or TA."
msgstr "اختر أستاذًا أو معيدًا."

msgid "Already acknowledged."
msgstr "أقررت بالفعل."

msgid "Expected a number."
msgstr "المتوقع رقم."

msgid "No term."
msgstr "لا يوجد فصل دراسي."

msgid "teacher or ta."
msgstr "أستاذ أو معيد."

msgid "No admission cycle."
msgstr "لا توجد دورة قبول."

msgid "No academic year."
msgstr "لا يوجد عام دراسي."

msgid "Choose a department."
msgstr "اختر قسمًا."

#, python-format
msgid "%(field)s: required"
msgstr "%(field)s: مطلوب"

msgid "university_number: no such student"
msgstr "الرقم الجامعي: لا يوجد طالب بهذا الرقم"

#, python-format
msgid "course_code: no offering %(code)s-%(section)s in this term"
msgstr "رمز المقرر: لا توجد شعبة %(code)s-%(section)s في هذا الفصل"

msgid "course_code: outside your department"
