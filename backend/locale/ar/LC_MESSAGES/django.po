#: academic/serializers.py:27
msgid "The end must be after the start."
msgstr "يجب أن يكون تاريخ النهاية بعد تاريخ البداية."

#: academic/serializers.py:62 academic/serializers.py:89
#: admissions/services.py:1048 students/services.py:66
msgid "The semester is 1 or 2."
msgstr "الفصل الدراسي إما الأول (1) أو الثاني (2)."

#: academic/serializers.py:99
msgid "The program belongs to another department."
msgstr "البرنامج يتبع قسمًا آخر."

#: academic/serializers.py:105
#, python-format
msgid "This program has %(levels_count)s levels."
msgstr "عدد مستويات هذا البرنامج %(levels_count)s."

#: academic/services.py:25 core/viewsets.py:76 students/services.py:43
msgid "Outside your department scope."
msgstr "خارج نطاق قسمك."

#: academic/services.py:38
#, python-format
msgid ""
"This person does not hold the «%(role)s» role: the system admin or academic "
"affairs grants it from Users."
msgstr ""
"هذا الشخص لا يحمل دور «%(role)s»: يمنحه مدير النظام أو أمين الشؤون العلمية "
"من «المستخدمون»."

#: academic/services.py:58
msgid "Already a member of this programme."
msgstr "مرتبط بهذا البرنامج بالفعل."

msgid "Choose the programme this person joins."
msgstr "اختر البرنامج الذي ينضم إليه."

msgid "This programme already has a course with this code."
msgstr "في هذا البرنامج مادة بهذا الرمز."

msgid "Choose the programme this course belongs to."
msgstr "اختر البرنامج الذي تنتمي إليه المادة."

#: academic/services.py:100
msgid "Add this person to the programme first."
msgstr "أضف هذا الشخص إلى البرنامج أولًا."

#: academic/services.py:114
msgid "Already assigned to this course."
msgstr "مُعيَّن على هذه المادة بالفعل."

#: academic/services.py:143
msgid "This student belongs to another department."
msgstr "هذا الطالب من قسم آخر؛ يسجّله مسؤول المسجلين."

#: academic/services.py:146
msgid "Only active students can be enrolled."
msgstr "لا يُسجَّل في المواد إلا الطلاب المنتظمون."

#: academic/services.py:149
msgid "This offering is closed."
msgstr "هذه الشعبة مغلقة."

#: academic/services.py:156
msgid "Already enrolled."
msgstr "مسجَّل بالفعل."

#: academic/services.py:173
msgid "This enrollment is not active."
msgstr "هذا التسجيل غير نشط."

#: accounts/authentication.py:29
msgid "User is inactive."
msgstr "الحساب معطَّل."

#: accounts/authentication.py:33 accounts/views.py:153
msgid "Session expired."
msgstr "انتهت الجلسة."

#: accounts/authentication.py:49
#, python-format
msgid "CSRF failed: %(reason)s"
msgstr "فشل التحقق من CSRF: %(reason)s"

# Strings added since 2026-10-25 without Arabic (review 2026-11 axis 8).
#: accounts/profile.py:29
msgid "Only a student edits these details here."
msgstr "هذه البيانات يعدّلها الطالب وحده هنا."

#: accounts/profile.py:45 accounts/services.py:1060
msgid "Enter a valid email address."
msgstr "أدخل بريدًا إلكترونيًا صحيحًا."

#: accounts/profile.py:65 accounts/services.py:698 contacts/visitor.py:60
msgid "Too many attempts. Request a new code."
msgstr "محاولات كثيرة. اطلب رمزًا جديدًا."

#: accounts/profile.py:67 accounts/services.py:165 accounts/services.py:170
#: accounts/services.py:700 contacts/visitor.py:62
msgid "Invalid or expired code."
msgstr "الرمز غير صحيح أو منتهي الصلاحية."

#: accounts/profile.py:76 accounts/services.py:227 accounts/services.py:279
#: accounts/services.py:1063
msgid "This email is already used by another account."
msgstr "هذا البريد مستخدم في حساب آخر."

#: accounts/profile.py:107
msgid "Upload your photo first."
msgstr "ارفع صورتك أولًا."

#: accounts/profile.py:133
msgid "A student's name is corrected by the registrar in the student record."
msgstr "اسم الطالب يصحّحه المسجّل في سجل الطالب."

#: accounts/serializers.py:320
msgid "Give a reason when dismissing."
msgstr "اكتب سبب رفض البلاغ."

#: accounts/serializers.py:332
msgid "Give a reason when rejecting."
msgstr "اذكر سبب الرفض."

#: accounts/serializers.py:366 accounts/services.py:1073
msgid "The Arabic name cannot be empty."
msgstr "الاسم بالعربية مطلوب."

#: accounts/serializers.py:415
msgid "Use a link that starts with https://"
msgstr "استخدم رابطًا يبدأ بـ https://"

#: accounts/services.py:115 accounts/services.py:135 accounts/services.py:206
msgid ""
"An account on this university number is waiting for the department's "
"approval. If it is not yours, report it."
msgstr ""
"على هذا الرقم الجامعي حساب ينتظر اعتماد القسم. إن لم يكن حسابك فأبلغ عن "
"انتحال."

#: accounts/services.py:122
msgid ""
"This university number already has an account. If it is not yours, report it."
msgstr "هذا الرقم الجامعي مرتبط بحساب. إن لم يكن حسابك فأبلغ عن انتحال."

#: accounts/services.py:168
msgid "Too many attempts. Start the registration again."
msgstr "محاولات كثيرة. ابدأ التسجيل من جديد."

#: accounts/services.py:180
msgid "Verify your email first."
msgstr "أكّد بريدك الإلكتروني أولًا."

#: accounts/services.py:193
msgid "This student already has an account."
msgstr "لهذا الطالب حساب بالفعل."

#: accounts/services.py:284
msgid ""
"Your earlier account is disabled. Ask the registrar to enable it, then "
"register again."
msgstr "حسابك السابق معطّل. اطلب من المسجّل تفعيله، ثم أعد التسجيل."

#: accounts/services.py:349
msgid "A move of this account already waits for the department's approval."
msgstr "طلب نقل لهذا الحساب ينتظر اعتماد القسم من قبل."

#: accounts/services.py:399
msgid "This record now holds another account. Reject this request."
msgstr "صار لهذا السجل حساب آخر. ارفض هذا الطلب لإغلاقه."

#: accounts/services.py:416 content/deletions.py:109
msgid "This request was already decided."
msgstr "بُتّ في هذا الطلب من قبل."

#: accounts/services.py:497
msgid "These details do not match an existing account."
msgstr "هذه البيانات لا تطابق حسابًا قائمًا."

#: accounts/services.py:536
msgid "This report was already decided."
msgstr "سبق البتّ في هذا البلاغ."

#: accounts/services.py:567 accounts/services.py:580
msgid "The account was stopped after an impersonation report."
msgstr "أُوقف الحساب بعد بلاغ انتحال."

#: accounts/services.py:659
msgid "Your account is waiting for approval."
msgstr "حسابك بانتظار الموافقة."

#: accounts/services.py:667
msgid "Incorrect email/university number or password."
msgstr "البريد أو الرقم الجامعي أو كلمة المرور غير صحيحة."

#: accounts/services.py:738
msgid "Change your own password from your settings."
msgstr "غيّر كلمة مرورك أنت من «الإعدادات»."

#: accounts/services.py:742
msgid ""
"Enable the account first: a disabled or not yet activated account has no "
"password."
msgstr "فعّل الحساب أولًا: الحساب المعطّل أو غير المفعّل ليس له كلمة مرور."

#: accounts/services.py:764
msgid "The current password is wrong."
msgstr "كلمة المرور الحالية غير صحيحة."

#: accounts/services.py:768
msgid "Choose a different password."
msgstr "اختر كلمة مرور مختلفة عن الحالية."

#: accounts/services.py:841
msgid "You cannot create accounts with this role."
msgstr "لا يمكنك إنشاء حسابات بهذا الدور."

#: accounts/services.py:846
msgid "An account with this email already exists."
msgstr "يوجد حساب بهذا البريد بالفعل."

#: accounts/services.py:890
msgid "This link is invalid or expired."
msgstr "هذا الرابط غير صالح أو منتهي الصلاحية."

#: accounts/services.py:909
msgid "This role requires a department."
msgstr "هذا الدور يتطلب تحديد القسم."

#: accounts/services.py:911
msgid "This role is college-wide."
msgstr "هذا الدور على مستوى الكلية ولا يُحدَّد له قسم."

#: accounts/services.py:918
msgid "You cannot grant this role."
msgstr "لا يمكنك منح هذا الدور."

#: accounts/services.py:920
msgid "Students get their role by registering."
msgstr "يحصل الطلاب على دورهم عند التسجيل."

#: accounts/services.py:922
msgid "You cannot grant a role to yourself."
msgstr "لا يمكنك منح نفسك دورًا."

#: accounts/services.py:924
msgid "A student account cannot hold a staff role."
msgstr "حساب الطالب لا يحمل دورًا إداريًا."

#: accounts/services.py:932
msgid "The user already has this role."
msgstr "المستخدم يحمل هذا الدور بالفعل."

#: accounts/services.py:947
msgid "You cannot revoke this role."
msgstr "لا يمكنك سحب هذا الدور."

#: accounts/services.py:949
msgid "You cannot remove your own system admin role."
msgstr "لا يمكنك سحب دور مدير النظام من نفسك."

#: accounts/services.py:971
msgid "You cannot delete your own account."
msgstr "لا يمكنك حذف حسابك."

#: accounts/services.py:986
msgid ""
"This account has a history (records, grades or log entries): disable it "
"instead of deleting it."
msgstr "لهذا الحساب سجل (عمليات أو درجات أو محتوى): عطّله بدل حذفه."

#: accounts/services.py:1084
msgid "Upload the photo first."
msgstr "ارفع الصورة أولًا."

#: accounts/services.py:1119
msgid "Only the system admin changes this account."
msgstr "لا يعدّل هذا الحساب إلا مدير النظام."

#: accounts/services.py:1130
msgid "You cannot disable your own account."
msgstr "لا يمكنك تعطيل حسابك."

#: accounts/staff_profile.py:37 accounts/views.py:350
msgid "Only staff appear on the public pages."
msgstr "يظهر الموظفون فقط في صفحات الموقع."

#: accounts/staff_profile.py:96
msgid "At most ten links."
msgstr "عشرة روابط على الأكثر."

#: accounts/views.py:112 accounts/views.py:157 accounts/views.py:208
#: files/views.py:158
msgid "ok"
msgstr "تم"

#: accounts/views.py:141
msgid "No session."
msgstr "لا توجد جلسة."

#: accounts/views.py:520
msgid "If the details match the college records, a code was sent to the email."
msgstr "إذا طابقت البيانات سجلات الكلية فقد أُرسل رمز إلى البريد."

#: accounts/views.py:541
msgid "Email verified."
msgstr "تم تأكيد البريد."

#: accounts/views.py:605
msgid "Your report reached the department. They will reply by email."
msgstr "وصل بلاغك إلى القسم، وسيردّ عليك بالبريد."

#: accounts/views.py:623
msgid "If an account uses this email, a code was sent to it."
msgstr "إذا كان هذا البريد مسجلًا فقد أُرسل إليه رمز."

#: accounts/views.py:639
msgid "Password changed. Sign in with the new password."
msgstr "تغيّرت كلمة المرور. سجّل الدخول بكلمة المرور الجديدة."

#: accounts/views.py:660
msgid "Password changed."
msgstr "تغيّرت كلمة المرور."

#: accounts/views.py:675
msgid "Account activated. You can sign in now."
msgstr "فُعِّل الحساب. يمكنك تسجيل الدخول الآن."

#: admissions/serializers.py:33
msgid "The cycle must close after it opens."
msgstr "يجب أن تُغلق الدورة بعد أن تُفتح."

#: admissions/serializers.py:77
msgid ""
"Applications were made to this intake: it keeps its programme and cycle. "
"Open a new one instead."
msgstr ""
"قُدِّمت طلبات إلى هذا البرنامج في هذه الدورة: يبقى على برنامجه ودورته. افتح "
"برنامجًا جديدًا بدلًا من ذلك."

#: admissions/serializers.py:88
msgid "The intake must close after it opens."
msgstr "يجب أن يُغلق التقديم بعد أن يُفتح."

#: admissions/serializers.py:103
msgid ""
"This programme or its department is stopped. Reactivate it in the academic "
"structure first."
msgstr "هذا البرنامج أو قسمه موقوف. أعد تفعيله من «الهيكل الأكاديمي» أولًا."

#: admissions/services.py:213
msgid "Each step must be an object with a list of sections."
msgstr "كل خطوة يجب أن تحوي قائمة أقسام."

#: admissions/services.py:217
msgid "Each section must be an object with a list of fields."
msgstr "كل قسم يجب أن يحوي قائمة حقول."

#: admissions/services.py:220
msgid "Each field must be an object."
msgstr "كل حقل يجب أن يكون عنصرًا مستقلًا."

# Form builder checks (review 2026-11 axis 8): the head registrar reads them as they are.
#: admissions/services.py:227
msgid "The schema needs a list of steps."
msgstr "الاستمارة تحتاج قائمة خطوات."

#: admissions/services.py:235
#, python-format
msgid "Field key %(key)s must be lowercase letters, digits or _."
msgstr "مفتاح الحقل %(key)s يُكتب بحروف لاتينية صغيرة وأرقام و_ فقط."

#: admissions/services.py:239
#, python-format
msgid "Field key %(key)s is used twice."
msgstr "مفتاح الحقل %(key)s مستعمل مرتين."

#: admissions/services.py:244
#, python-format
msgid "%(field)s: unknown type %(type)s."
msgstr "%(field)s: نوع غير معروف (%(type)s)."

#: admissions/services.py:247
#, python-format
msgid "%(field)s: add the options."
msgstr "%(field)s: أضف الخيارات."

#: admissions/services.py:253
#, python-format
msgid "%(field)s: the pattern is not a valid regular expression."
msgstr "%(field)s: نمط التحقق غير صحيح."

#: admissions/services.py:257
#, python-format
msgid "%(field)s: choose who fills this field."
msgstr "%(field)s: اختر من يعبئ هذا الحقل."

#: admissions/services.py:261
#, python-format
msgid "%(field)s: the university number is filled by the college."
msgstr ""
"%(field)s: الرقم الجامعي يعبئه موظف التسجيل؛ اجعله «للموظفين» أو «يُتاح "
"للمتقدم»."

#: admissions/services.py:265
#, python-format
msgid "%(field)s: width must be full or half."
msgstr "%(field)s: العرض كامل أو نصف."

#: admissions/services.py:268
#, python-format
msgid "%(field)s: the condition is not valid."
msgstr "%(field)s: شرط الظهور غير صالح."

#: admissions/services.py:275
#, python-format
msgid "%(field)s: the condition must name a field above it."
msgstr "%(field)s: شرط الظهور يجب أن يشير إلى حقل قبله."

#: admissions/services.py:282
#, python-format
msgid "%(field)s: choose the answers that show this field."
msgstr "%(field)s: اختر الإجابات التي تُظهر هذا الحقل."

#: admissions/services.py:286
#, python-format
msgid "%(field)s: the condition must name a field the applicant fills."
msgstr "%(field)s: شرط الظهور يجب أن يشير إلى حقل يعبئه المتقدم."

#: admissions/services.py:298
#, python-format
msgid "%(field)s: accepted files must be some of %(types)s."
msgstr "%(field)s: الملفات المقبولة يجب أن تكون من %(types)s."

#: admissions/services.py:321
msgid "Must be text."
msgstr "يجب أن يكون نصًا."

#: admissions/services.py:323
msgid "Must be true or false."
msgstr "يجب أن يكون نعم أو لا."

#: admissions/services.py:326 admissions/services.py:330
msgid "Must be a date (YYYY-MM-DD)."
msgstr "يجب أن يكون تاريخًا (سنة-شهر-يوم)."

#: admissions/services.py:336 admissions/services.py:338
#: inquiries/services.py:47 inquiries/services.py:49
msgid "Invalid phone number."
msgstr "رقم الهاتف غير صحيح — اكتبه مثل 0912345678 أو +249912345678."

#: admissions/services.py:340
msgid "Must be a year."
msgstr "يجب أن يكون سنة."

#: admissions/services.py:344 admissions/services.py:416
msgid "Choose from the options."
msgstr "اختر من الخيارات."

#: admissions/services.py:364 admissions/services.py:664
msgid "Upload this document."
msgstr "ارفع هذا المستند."

#: admissions/services.py:367 admissions/services.py:371
#: admissions/services.py:655
msgid "Required."
msgstr "مطلوب."

#: admissions/services.py:388
msgid "Must be an amount."
msgstr "يجب أن يكون مبلغًا."

#: admissions/services.py:392 admissions/services.py:397
#: admissions/services.py:400
msgid "Must be a number."
msgstr "يجب أن يكون رقمًا."

#: admissions/services.py:405
msgid "Out of range."
msgstr "خارج النطاق المسموح."

#: admissions/services.py:410
msgid "Invalid email."
msgstr "بريد إلكتروني غير صحيح."

#: admissions/services.py:412
msgid "Choose one of the options."
msgstr "اختر أحد الخيارات."

#: admissions/services.py:422
msgid "Invalid format."
msgstr "الصيغة غير صحيحة."

#: admissions/services.py:442 exams/services.py:149
msgid "Only a draft can be published."
msgstr "لا تُنشر إلا المسودة."

#: admissions/services.py:480
msgid "This program is not accepting applications now."
msgstr "هذا البرنامج لا يستقبل طلبات الآن."

#: admissions/services.py:487
msgid "You already have an application for this program."
msgstr "لديك طلب لهذا البرنامج بالفعل."

#: admissions/services.py:492
#, python-format
msgid "At most %(limit)s applications per admission cycle."
msgstr "الحد الأقصى %(limit)s طلبات في دورة القبول."

#: admissions/services.py:515
msgid "Please try again."
msgstr "أعد المحاولة."

#: admissions/services.py:544 admissions/services.py:904
msgid "Send an object of answers."
msgstr "أرسل الإجابات في كائن."

#: admissions/services.py:550
msgid ""
"The application can only change while it is a draft or missing documents."
msgstr "لا يتغير الطلب إلا وهو مسودة أو بمستندات ناقصة."

#: admissions/services.py:571
msgid "These fields are filled by the college."
msgstr "هذه الحقول تعبئها الكلية."

#: admissions/services.py:606 admissions/services.py:618
msgid "Documents can be added while the application is open."
msgstr "تُضاف المستندات ما دام الطلب مفتوحًا."

#: admissions/services.py:657 inquiries/services.py:104
msgid "Give an email or a phone number."
msgstr "أدخل بريدًا إلكترونيًا أو رقم هاتف."

#: admissions/services.py:668
msgid "The admission window has closed."
msgstr "انتهت فترة القبول."

#: admissions/services.py:716
msgid "This application can no longer be withdrawn."
msgstr "لم يعد ممكنًا سحب هذا الطلب."

#: admissions/services.py:727
msgid "This application is closed."
msgstr "هذا الطلب مغلق."

#: admissions/services.py:746
msgid "This application belongs to another department."
msgstr "هذا الطلب يتبع قسمًا آخر."

#: admissions/services.py:761
msgid "This person does not register for this department."
msgstr "هذا الشخص ليس مسجلًا لهذا القسم."

#: admissions/services.py:797
#, python-format
msgid "You cannot move this application from %(status)s to %(to)s."
msgstr "لا يمكن نقل الطلب من %(status)s إلى %(to)s."

#: admissions/services.py:802
msgid "Tell the applicant what is missing."
msgstr "أخبر المتقدم بما ينقصه."

#: admissions/services.py:811
msgid "This application changed meanwhile; reload it and decide again."
msgstr "تغيّر هذا الطلب في الأثناء؛ أعد تحميله ثم اتخذ القرار."

#: admissions/services.py:858
msgid "Email the applicant or add an internal note."
msgstr "راسل المتقدم بالبريد أو أضف ملاحظة داخلية."

#: admissions/services.py:911
#, python-format
msgid "Not a staff field of this form: %(keys)s"
msgstr "ليست من حقول الموظفين في هذه الاستمارة: %(keys)s"

#: admissions/services.py:932
msgid "The student is registered: change the number on the student record."
msgstr "الطالب مسجَّل: عدّل رقمه الجامعي من سجل الطالب."

#: admissions/services.py:943
#, python-format
msgid "At most %(n)s characters."
msgstr "لا يزيد على %(n)s حرفًا."

#: admissions/services.py:955 admissions/services.py:1013
msgid "This university number is already in use."
msgstr "هذا الرقم الجامعي مستخدم."

#: admissions/services.py:960
msgid "Only fields marked for release can be released."
msgstr "لا يُتاح للمتقدم إلا ما عُلِّم «يُتاح للمتقدم»."

#: admissions/services.py:1009
msgid "Enter the university number first."
msgstr "أدخل الرقم الجامعي أولًا."

#: admissions/services.py:1050
msgid "Only the head registrar registers applicants."
msgstr "لا يسجّل المتقدمين طلابًا إلا مسؤول المسجلين."

#: admissions/services.py:1055
msgid "Only an accepted, not yet registered applicant can be registered."
msgstr "لا يُسجَّل إلا متقدم مقبول لم يُسجَّل بعد."

#: admissions/views.py:101
msgid "Applications exist; close the intake instead."
msgstr "توجد طلبات؛ أغلق البرنامج في الدورة بدلًا من حذفه."

#: admissions/views.py:120 core/viewsets.py:130
msgid ""
"This item is in use and cannot be deleted. Deactivate or archive it instead."
msgstr "هذا العنصر مستخدم ولا يمكن حذفه. عطّله أو أرشفه بدلًا من ذلك."

