msgid "university_number: not enrolled in this course"
msgstr "الرقم الجامعي: الطالب غير مسجل في هذه المادة"

msgid "status: use pass/fail/absent/withdrawn/incomplete"
msgstr ""
"الحالة: استخدم pass/fail/absent/withdrawn/incomplete (ناجح/راسب/غائب/منسحب/"
"غير مكتمل)"

msgid "score: must be a number"
msgstr "الدرجة: يجب أن تكون رقمًا"

msgid "score: must be between 0 and 100"
msgstr "الدرجة: يجب أن تكون بين 0 و100"

msgid "score: required"
msgstr "الدرجة: مطلوبة"

#, python-format
msgid "letter: %(given)s does not match the scale (%(letter)s for %(score)s)"
msgstr ""
"التقدير: %(given)s لا يطابق سلّم التقديرات (%(letter)s للدرجة %(score)s)"

msgid "duplicated in this file"
msgstr "مكرر في هذا الملف"

msgid "already has a result; request a correction instead"
msgstr "له نتيجة بالفعل؛ اطلب تعديلًا بدلًا من ذلك"

msgid "Give a new score or status."
msgstr "أدخل درجة أو حالة جديدة."

msgid "Include a band starting at 0."
msgstr "أضف فئة تبدأ من 0."

msgid "Outside your results scope."
msgstr "خارج نطاق نتائجك."

msgid "This batch was already committed or rejected."
msgstr "اعتُمدت هذه الدفعة أو رُفضت من قبل."

msgid ""
"Some students got a result from another batch meanwhile. Upload the file "
"again."
msgstr "حصل بعض الطلاب على نتيجة من دفعة أخرى في الأثناء. ارفع الملف من جديد."

msgid "A committed batch cannot be deleted; unpublish it instead."
msgstr "لا تُحذف دفعة معتمدة؛ ألغِ نشرها بدلًا من ذلك."

msgid "Nothing would change."
msgstr "لن يتغير شيء."

msgid "This result already has a pending correction."
msgstr "لهذه النتيجة طلب تعديل معلّق بالفعل."

msgid "Already decided."
msgstr "بُتّ فيه من قبل."

msgid "Choose your department."
msgstr "اختر قسمك."

msgid "Outside your department."
msgstr "خارج قسمك."

msgid "Save the CSV as UTF-8."
msgstr "احفظ ملف CSV بترميز UTF-8."

msgid "Choose a term."
msgstr "اختر الفصل الدراسي."

msgid "Upload the file for this purpose first."
msgstr "ارفع الملف لهذا الغرض أولًا."

msgid "Published regulations change through a new version."
msgstr "اللوائح المنشورة تتغير بإصدار جديد."

msgid "Only a published regulation gets a new version."
msgstr "لا يُصدر إصدار جديد إلا للائحة منشورة."

msgid "Already published."
msgstr "منشورة بالفعل."

msgid "Write the text or attach the PDF."
msgstr "اكتب النص أو أرفق ملف PDF."

msgid "This regulation needs no acknowledgement."
msgstr "هذه اللائحة لا تتطلب إقرارًا."

msgid "Upload each attachment first."
msgstr "ارفع كل مرفق أولًا."

msgid "Write the note."
msgstr "اكتب الملاحظة."

msgid "Reopen the case first."
msgstr "أعد فتح الحالة أولًا."

msgid "Must be after the start date."
msgstr "يجب أن يكون بعد تاريخ البداية."

msgid "Already visible to the student."
msgstr "ظاهرة للطالب بالفعل."

msgid "Nothing to change."
msgstr "لا شيء لتغييره."

msgid "You can report only in courses you teach or manage."
msgstr "لا يمكنك الإبلاغ إلا في مواد تدرّسها أو تديرها."

msgid "This student is not in the course."
msgstr "هذا الطالب ليس في المادة."

msgid "The attempt belongs to another student or course."
msgstr "المحاولة تخص طالبًا أو مادة أخرى."

msgid "Already handled."
msgstr "عولج من قبل."

msgid "Student affairs suspends or reinstates only."
msgstr "شؤون الطلاب توقف الطالب أو ترفع إيقافه فقط."

msgid "The student already has this status."
msgstr "الطالب في هذه الحالة بالفعل."

msgid "University number"
msgstr "الرقم الجامعي"

msgid "Name in Arabic"
msgstr "الاسم بالعربية"

msgid "Program code"
msgstr "رمز البرنامج"

msgid "Level"
msgstr "المستوى"

msgid "Course code"
msgstr "رمز المقرر"

msgid "The file is larger than 5 MB."
msgstr "حجم الملف أكبر من 5 ميغابايت."

msgid "Upload an Excel (.xlsx) or CSV file."
msgstr "ارفع ملف Excel (.xlsx) أو CSV."

msgid "The file is empty."
msgstr "الملف فارغ."

#, python-format
msgid "Missing required columns: %(join)s."
msgstr "أعمدة مطلوبة ناقصة: %(join)s."

#, python-format
msgid "The file has more than %(MAX_ROWS)s rows."
msgstr "الملف يتجاوز %(MAX_ROWS)s صفًا."

#, python-format
msgid "program_code: unknown program %(get)s"
msgstr "رمز البرنامج: برنامج غير معروف %(get)s"

msgid "level: must be a number"
msgstr "المستوى: يجب أن يكون رقمًا"

#, python-format
msgid "level: must be between 1 and %(levels_count)s"
msgstr "المستوى: يجب أن يكون بين 1 و%(levels_count)s"

msgid "email: invalid"
msgstr "البريد: غير صالح"

msgid "phone: invalid"
msgstr "الهاتف: غير صالح"

msgid "gender: use male/female (ذكر/أنثى)"
msgstr "الجنس: استخدم male/female (ذكر/أنثى)"

msgid "birth_date: use YYYY-MM-DD or DD/MM/YYYY"
msgstr "تاريخ الميلاد: استخدم YYYY-MM-DD أو DD/MM/YYYY"

msgid "university_number: duplicated in this file"
msgstr "الرقم الجامعي: مكرر في هذا الملف"
