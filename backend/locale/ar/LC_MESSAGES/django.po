msgid "An unexpected error occurred."
msgstr "حدث خطأ غير متوقع."

msgid ""
"This item is in use and cannot be deleted. Deactivate or archive it instead."
msgstr "هذا العنصر مستخدم ولا يمكن حذفه. عطّله أو أرشفه بدلًا من ذلك."

msgid "Add at least two choices."
msgstr "أضف خيارين على الأقل."

msgid "Mark exactly one correct choice."
msgstr "حدّد خيارًا صحيحًا واحدًا بالضبط."

msgid "Mark at least one correct choice."
msgstr "حدّد خيارًا صحيحًا واحدًا على الأقل."

msgid "Must be after the opening time."
msgstr "يجب أن يكون بعد وقت الفتح."

msgid "Add the choices."
