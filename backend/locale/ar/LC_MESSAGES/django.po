msgid "Invalid request"
msgstr "طلب غير صالح"

msgid "Authentication required"
msgstr "يلزم تسجيل الدخول"

msgid "Not allowed"
msgstr "غير مسموح"

msgid "Not found"
msgstr "غير موجود"

msgid "Method not allowed"
msgstr "الطريقة غير مسموحة"

msgid "Too many requests"
msgstr "طلبات كثيرة"

msgid "Server error"
msgstr "خطأ في الخادم"

msgid "Error"
msgstr "خطأ"

msgid "One or more fields are invalid."
msgstr "بعض الحقول غير صحيحة."

msgid "No endpoint matches this path."
