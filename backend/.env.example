# Development needs none of these: `scripts/dev.sh` runs on SQLite with no services.
# Production (config.settings.prod) requires the ones marked REQUIRED.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=                       # REQUIRED — long random string
DJANGO_ALLOWED_HOSTS=api.ecst.edu.sd      # comma-separated
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.ecst.edu.sd
# Public website (apps/landing): origins allowed to call /api/public/* (contact form, 404 redirects).
PUBLIC_SITE_ORIGINS=https://ecst.edu.sd,https://www.ecst.edu.sd
# Shared secret with the site build (header X-Site-Build) so the build isn't throttled. Long random string.
SITE_BUILD_TOKEN=                    # REQUIRED
# Static host deploy hook (e.g. Render static site "Deploy Hook"); publishing content triggers it.
SITE_REBUILD_HOOK_URL=
DJANGO_LOG_LEVEL=INFO

DATABASE_URL=postgres://user:pass@host:5432/ecst   # REQUIRED — PostgreSQL 16
REDIS_URL=redis://host:6379/0                      # REQUIRED — cache, throttling, Celery broker

# Email provider (Anymail). Pick one backend and set its key.
MAILER_BACKEND=anymail.backends.brevo.EmailBackend  # or anymail.backends.resend.EmailBackend
BREVO_API_KEY=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=ECST <no-reply@ecst.edu.sd>
