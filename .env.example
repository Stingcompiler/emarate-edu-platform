
# Private files and lecture videos (Bunny.net). MEDIA_BACKEND=bunny is the default in production.
MEDIA_BACKEND=bunny
BUNNY_STORAGE_ZONE=                  # REQUIRED — private storage zone name
BUNNY_STORAGE_KEY=                   # REQUIRED — storage zone password
BUNNY_STORAGE_HOST=https://storage.bunnycdn.com   # regional host, e.g. https://uk.storage.bunnycdn.com
BUNNY_PULL_ZONE_URL=                 # REQUIRED — https://ecst-private.b-cdn.net (token auth ON)
BUNNY_TOKEN_KEY=                     # REQUIRED — pull zone token authentication key
BUNNY_STREAM_LIBRARY_ID=             # REQUIRED
BUNNY_STREAM_API_KEY=                # REQUIRED — library API key (also signs TUS uploads)
BUNNY_STREAM_TOKEN_KEY=              # REQUIRED — library embed token authentication key
BUNNY_WEBHOOK_SECRET=                # REQUIRED — random; webhook URL: /api/public/webhooks/bunny-stream?secret=…
