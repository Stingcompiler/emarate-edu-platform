---
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/noto-kufi-arabic/700.css";
import "../styles/global.css";
import { PORTAL, site as loadSite, pages, programs as loadPrograms } from "../lib/api";
import { type Lang, dir, href, pick, t } from "../lib/i18n";
import { navigation } from "../lib/menus";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path after /{lang}/ for the other-language link and hreflang. */
  path?: string;
  jsonLd?: object | object[];
  image?: string | null;
  /** The page shows a fixed bar at the bottom on phones; keep the footer clear of it. */
  bottomBar?: boolean;
}

const { lang, title, description, path = "", jsonLd, image, bottomBar = false } = Astro.props;
const s = await loadSite();
// Legal pages sit in the footer's bottom bar, once published — never a link to a 404.
const published = await pages();
const legal = (["privacy", "terms", "accessibility"] as const)
  .map((slug) => published.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);
const siteName = pick(lang, s.name_ar, s.name_en);
const shortName = siteName.split(" ").slice(0, 2).join(" ");
const other: Lang = lang === "ar" ? "en" : "ar";
const canonical = new URL(href(lang, path), Astro.site);
const alternate = (l: Lang) => new URL(href(l, path), Astro.site).toString();
// Every page describes itself (review 2026-09-30: ~70 pages shared the college's name as
// their description, so search results all looked alike).
const desc =
  description ||
  (title !== siteName
    ? `${title} — ${siteName}${s.tagline ? `. ${s.tagline}` : ""}`
    : s.seo?.description || s.tagline || siteName);
// A picture for WhatsApp/Facebook previews: the page's own, else the college's share image.
const shareImage = image || s.share_image_url || null;
// «قدّم الآن» sits in the header whenever an intake is open (review W1).
const applying = (await loadPrograms()).some((p) => p.intake?.accepting);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const current = Astro.url.pathname;
const header = await navigation(lang, "header", current);
const footer = await navigation(lang, "footer", current);
// Loose footer links (not in a group) share one column.
const footerColumns = [
  ...footer.filter((e) => e.children.length),
  ...(footer.some((e) => !e.children.length)
    ? [
        {
          label: lang === "ar" ? "روابط" : "Links",
          children: footer.filter((e) => !e.children.length),
        },
      ]
    : []),
];
const ext = (external: boolean) => (external ? { rel: "noopener", target: "_blank" } : {});
---

<!doctype html>
<!-- Light by default, the white brand surface (docs/brand); a visitor may choose dark (D28). -->
<html lang={lang} dir={dir(lang)} data-theme="light" class="bg-bg">
  <head>
    <meta charset="utf-8" />
    <!-- Before paint, so a dark choice never flashes white. Same key as the portal. -->
    <script is:inline>
      try {
        if (localStorage.getItem("ecst-theme") === "dark")
          document.documentElement.setAttribute("data-theme", "dark");
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "ar" ? "أخبار الكلية" : "College news"}
      href={href(lang, "news/rss.xml")}
    />
    <link rel="alternate" hreflang="ar" href={alternate("ar")} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="x-default" href={alternate("ar")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "ar" ? "ar_SD" : "en_GB"} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#0b2447" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {jsonLd && (
      // "<" escaped: a title containing "</script>" must not close the tag (stored XSS).
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
    >
      {lang === "ar" ? "تخطَّ إلى المحتوى" : "Skip to content"}
    </a>
    <header class="motion-header sticky top-0 z-20 border-b border-border-soft bg-surface/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 lg:px-8">
        <a href={href(lang)} class="flex min-w-0 items-center gap-2 text-sm font-bold text-text">
          <img src="/favicon.svg" alt="" width="32" height="32" class="rounded-md" />
          <span class="truncate sm:hidden">{shortName}</span>
          <span class="hidden truncate sm:inline">{siteName}</span>
        </a>
        <nav
          class="ms-auto hidden items-center gap-0.5 lg:flex"
          aria-label={lang === "ar" ? "الرئيسية" : "Main"}
        >
          {header.map((e) =>
            e.children.length ? (
              <details data-menu class="relative">
                <summary
                  data-current={e.active ? "" : undefined}
                  class:list={[
                    "motion-nav-link flex cursor-pointer list-none items-center gap-1 rounded-md px-2.5 py-2 text-sm font-semibold whitespace-nowrap hover:bg-surface-alt",
                    e.active ? "text-primary" : "text-text-muted",
                  ]}
                >
                  {e.label}
                  <svg
                    class="motion-chevron"
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <div class="motion-drop absolute start-0 top-11 z-30 w-64 rounded-xl border border-border-soft bg-surface p-2 shadow-lg">
                  {e.children.map((c) => (
                    <a
                      href={c.href}
                      {...ext(c.external)}
                      aria-current={c.active ? "page" : undefined}
                      class:list={[
                        "block rounded-md px-3 py-2 text-sm hover:bg-surface-alt",
                        c.active ? "font-semibold text-primary" : "text-text",
                      ]}
                    >
                      {c.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={e.href}
                {...ext(e.external)}
                aria-current={e.active ? "page" : undefined}
                class:list={[
                  "motion-nav-link rounded-md px-2.5 py-2 text-sm font-semibold whitespace-nowrap hover:bg-surface-alt",
                  e.active ? "text-primary" : "text-text-muted",
                ]}
              >
                {e.label}
              </a>
            ),
          )}
        </nav>
        <button
          type="button"
          data-theme-toggle
          aria-pressed="false"
          class="hidden size-10 shrink-0 place-items-center rounded-md text-text-muted hover:bg-surface-alt hover:text-text sm:ms-auto sm:grid lg:ms-0"
        >
          <span class="sr-only theme-when-light">{t(lang, "darkMode")}</span>
          <span class="sr-only theme-when-dark">{t(lang, "lightMode")}</span>
          <svg
            class="theme-when-light"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <svg
            class="theme-when-dark"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>
        <a
          href={href(other, path)}
          hreflang={other}
          class="hidden text-xs font-semibold text-text-muted hover:text-text sm:inline"
        >
          {t(lang, "other")}
        </a>
        <a
          href={`${PORTAL}/login`}
          class:list={[
            "whitespace-nowrap rounded-md px-3 py-2 text-xs font-semibold text-text hover:bg-surface-alt sm:text-sm",
            applying ? "hidden sm:inline-block" : "ms-auto bg-surface-alt sm:ms-0",
          ]}
        >
          {t(lang, "portal")}
        </a>
        {applying && (
          <a
            href={`${PORTAL}/apply`}
            class="ms-auto whitespace-nowrap rounded-md bg-accent px-3 py-2 text-xs font-bold text-on-primary hover:bg-accent-hover sm:ms-0 sm:text-sm"
          >
            {t(lang, "apply")}
          </a>
        )}
        <details data-menu class="lg:hidden">
          <summary
            class="grid size-10 cursor-pointer list-none place-items-center rounded-md hover:bg-surface-alt"
            aria-label={lang === "ar" ? "القائمة" : "Menu"}
          >
            <svg
              class="motion-burger"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 7h16" />
              <path d="M4 12h16" />
              <path d="M4 17h16" />
            </svg>
          </summary>
          <div class="motion-drop fixed inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-border-soft bg-surface px-4 pb-6 pt-2 shadow-lg">
            <div class="mx-auto max-w-2xl">
              <div class="grid grid-cols-2 gap-2 py-2">
                <a
                  href={`${PORTAL}/apply`}
                  class="rounded-lg bg-primary px-3 py-3 text-center text-sm font-bold text-on-primary"
                >
                  {t(lang, "apply")}
                </a>
                <a
                  href={`${PORTAL}/track`}
                  class="rounded-lg border border-border px-3 py-3 text-center text-sm font-semibold text-text"
                >
                  {t(lang, "track")}
                </a>
              </div>
              {header.map((e) =>
                e.children.length ? (
                  <section class="border-t border-border-soft py-2">
                    <p class="px-3 pb-1 pt-2 text-xs font-semibold text-text-muted">{e.label}</p>
                    <div class="grid sm:grid-cols-2">
                      {e.children.map((c) => (
                        <a
                          href={c.href}
                          {...ext(c.external)}
                          aria-current={c.active ? "page" : undefined}
                          class:list={[
                            "block rounded-md px-3 py-2.5 text-sm hover:bg-surface-alt",
                            c.active ? "font-semibold text-primary" : "font-semibold text-text",
                          ]}
                        >
                          {c.label}
                        </a>
                      ))}
                    </div>
                  </section>
                ) : (
                  <a
                    href={e.href}
                    {...ext(e.external)}
                    aria-current={e.active ? "page" : undefined}
                    class:list={[
                      "block border-t border-border-soft px-3 py-3 text-sm font-semibold hover:bg-surface-alt",
                      e.active ? "text-primary" : "text-text",
                    ]}
                  >
                    {e.label}
                  </a>
                ),
              )}
              <a
                href={href(other, path)}
                hreflang={other}
                class="block border-t border-border-soft px-3 py-3 text-sm font-semibold text-text-muted hover:bg-surface-alt sm:hidden"
              >
                {t(lang, "other")}
              </a>
              <button
                type="button"
                data-theme-toggle
                aria-pressed="false"
                class="flex w-full items-center gap-2 border-t border-border-soft px-3 py-3 text-start text-sm font-semibold text-text-muted hover:bg-surface-alt sm:hidden"
              >
                <span class="theme-when-light">{t(lang, "darkMode")}</span>
                <span class="theme-when-dark">{t(lang, "lightMode")}</span>
              </button>
            </div>
          </div>
        </details>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer
      class:list={[
        "mt-16 bg-header text-sm text-navy-100",
        // Room for the phone's fixed bottom bar, in the footer's own colour (W8: it was a
        // white strip under the footer when the padding sat on <body>).
        bottomBar && "pb-20 lg:pb-0",
      ]}
    >
      <div
        class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 lg:grid-cols-[var(--footer-cols)] lg:px-8"
        style={`--footer-cols: 1.5fr repeat(${Math.max(footerColumns.length, 1)}, 1fr)`}
      >
        <div class="col-span-2 lg:col-span-1">
          <p class="font-bold text-white">{siteName}</p>
          {s.tagline && <p class="mt-2 leading-6">{s.tagline}</p>}
          <address class="mt-4 space-y-1 not-italic leading-6">
            {s.address && <p>{s.address}</p>}
            {s.phone && (
              <p>
                <a href={`tel:${s.phone.replace(/\s/g, "")}`} dir="ltr" class="hover:text-white">
                  {s.phone}
                </a>
              </p>
            )}
            {s.email && (
              <p>
                <a href={`mailto:${s.email}`} class="hover:text-white">
                  {s.email}
                </a>
              </p>
            )}
            {s.whatsapp_e164 && (
              <p>
                <a
                  href={`https://wa.me/${s.whatsapp_e164.replace("+", "")}`}
                  class="hover:text-white"
                >
                  WhatsApp
                </a>
              </p>
            )}
          </address>
          <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 font-semibold">
            <a href={`${PORTAL}/apply`} class="text-white hover:underline">
              {t(lang, "apply")}
            </a>
            <a href={`${PORTAL}/track`} class="hover:text-white">
              {t(lang, "track")}
            </a>
          </p>
        </div>
        {footerColumns.map((col) => (
          <nav aria-label={col.label}>
            <p class="font-semibold text-white">{col.label}</p>
            <ul class="mt-3 space-y-1">
              {col.children.map((c) => (
                <li>
                  <a href={c.href} {...ext(c.external)} class="inline-block py-1 hover:text-white">
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <div class="border-t border-navy-700">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 text-xs text-navy-300 lg:px-8">
          {/* The copyright, then who built the site: beside it on wide screens, under it on phones. */}
          <div class="flex flex-col gap-1 md:flex-row md:items-center md:gap-3">
            <p>
              © {new Date().getFullYear()} {siteName}
            </p>
            <span aria-hidden="true" class="hidden md:inline">
              ·
            </span>
            <p>
              <a
                href="https://stingdev.pro"
                target="_blank"
                rel="noopener"
                class="underline-offset-2 hover:text-white hover:underline"
              >
                {t(lang, "poweredBy")}
                <span class="sr-only"> {t(lang, "newTab")}</span>
              </a>
            </p>
          </div>
          {legal.length > 0 && (
            <nav
              aria-label={lang === "ar" ? "السياسات" : "Policies"}
              class="flex flex-wrap gap-x-4"
            >
              {legal.map((p) => (
                <a href={href(lang, `${p.path}/`)} class="hover:text-white">
                  {pick(lang, p.title_ar, p.title_en)}
                </a>
              ))}
            </nav>
          )}
        </div>
      </div>
    </footer>
    {/* WhatsApp is how most applicants and parents here ask first (landing review 2026-10):
        one tap from every page. On a page with its own bottom bar the phone uses that. */}
    {s.whatsapp_e164 && path !== "contact/" && (
      <a
        href={`https://wa.me/${s.whatsapp_e164.replace(/\D/g, "")}`}
        rel="noopener"
        target="_blank"
        data-no-print
        data-whatsapp-float
        aria-label={lang === "ar" ? "تواصل عبر واتساب" : "Chat on WhatsApp"}
        class:list={[
          "fixed end-3 bottom-3 z-10 size-12 place-items-center rounded-full bg-success text-white shadow-lg hover:bg-success-strong mb-[env(safe-area-inset-bottom)] lg:end-4 lg:bottom-4 lg:size-14",
          bottomBar ? "hidden lg:grid" : "grid",
        ]}
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5A8 8 0 1 1 21 12z" />
          <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1c-1-.5-2-1.5-2.5-2.5l1-1-1-2z" />
        </svg>
      </a>
    )}
    <script>
      // Motion (packages/ui/src/motion.css): reveal what scrolls into view and count figures
      // up once. Nothing is hidden before this runs, and «reduce motion» turns it off.
      const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!calm && "IntersectionObserver" in window) {
        const fmt = (n: number, lang: string) =>
          Math.round(n).toLocaleString(lang === "ar" ? "ar" : "en");
        const countUp = (el: HTMLElement) => {
          const target = Number(el.dataset.count);
          const lang = document.documentElement.lang;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 800);
            el.textContent = fmt(target * (1 - (1 - t) ** 3), lang);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.classList.remove("is-pending");
              if (el.dataset.reveal !== undefined) el.classList.add("is-revealed");
              if (el.dataset.count) countUp(el);
              seen.unobserve(el);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        document.querySelectorAll<HTMLElement>("[data-reveal], [data-count]").forEach((el) => {
          // Only what is well below the fold waits for its entrance (W5: not what sits just
          // under it, which a short scroll or a tall screen may never "enter").
          if (el.getBoundingClientRect().top > window.innerHeight * 1.25)
            el.classList.add("is-pending");
          seen.observe(el);
        });
        // A safety net (W5): printing, or an in-app browser whose observer never reports,
        // must not leave content hidden — whatever is on or above the screen is shown.
        const catchUp = (all = false) =>
          document.querySelectorAll<HTMLElement>(".is-pending").forEach((el) => {
            // Above the observer's own line (rootMargin −8%): it should have fired already.
            if (all || el.getBoundingClientRect().top < window.innerHeight * 0.9) {
              el.classList.remove("is-pending");
              seen.unobserve(el);
            }
          });
        window.addEventListener("beforeprint", () => catchUp(true));
        setTimeout(catchUp, 2500);
        let queued = false;
        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            setTimeout(() => ((queued = false), catchUp()), 400);
          },
          { passive: true },
        );
      }

      // The header floats (a shadow) once content scrolls under it.
      const header = document.querySelector<HTMLElement>("header.motion-header");
      const lift = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
      lift();
      window.addEventListener("scroll", lift, { passive: true });

      // Light or dark (D28): the choice is kept, in the same key as the portal. Printing (the
      // programme brochure) is always light.
      const root = document.documentElement;
      const toggles = () => document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
      const show = () =>
        toggles().forEach((b) =>
          b.setAttribute("aria-pressed", String(root.dataset.theme === "dark")),
        );
      show();
      toggles().forEach((b) =>
        b.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            if (next === "dark") localStorage.setItem("ecst-theme", "dark");
            else localStorage.removeItem("ecst-theme");
          } catch {
            /* private mode: the choice lasts for this page */
          }
          show();
        }),
      );
      let printedFrom = "";
      window.addEventListener("beforeprint", () => {
        printedFrom = root.dataset.theme ?? "light";
        root.dataset.theme = "light";
      });
      window.addEventListener(
        "afterprint",
        () => printedFrom && (root.dataset.theme = printedFrom),
      );

      // Menus are <details> (they work without JS); this makes them behave like menus:
      // one open at a time, closed by a tap outside or by Esc.
      const menus = () => document.querySelectorAll<HTMLDetailsElement>("details[data-menu]");
      menus().forEach((d) =>
        d.addEventListener("toggle", () => {
          if (d.open) menus().forEach((o) => o !== d && (o.open = false));
        }),
      );
      document.addEventListener("click", (e) =>
        menus().forEach((d) => d.open && !d.contains(e.target as Node) && (d.open = false)),
      );
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        menus().forEach((d) => {
          if (!d.open) return;
          d.open = false;
          d.querySelector("summary")?.focus();
        });
      });
    </script>
  </body>
</html>
