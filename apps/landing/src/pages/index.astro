---
// "/" → Arabic home. Static hosts serve this file; the meta refresh and the
// link cover browsers and crawlers (canonical points at /ar/).
const target = new URL("/ar/", Astro.site).toString();
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/ar/" />
    <link rel="canonical" href={target} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {import.meta.env.SITE_NOINDEX === "1" && <meta name="robots" content="noindex, nofollow" />}
    <title>كلية الإمارات للعلوم والتقنية</title>
  </head>
  <body>
    <a href="/ar/">كلية الإمارات للعلوم والتقنية</a> · <a href="/en/">English</a>
  </body>
</html>
