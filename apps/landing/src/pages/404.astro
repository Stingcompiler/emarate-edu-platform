---
import Base from "../layouts/Base.astro";
import { API, PORTAL } from "../lib/api";
---

<Base lang="ar" title="الصفحة غير موجودة">
  <div class="mx-auto max-w-6xl px-4 py-16 lg:px-8 lg:py-24" id="not-found" data-api={API}>
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="font-display text-7xl font-bold text-primary">404</p>
        <h1 class="mt-4 font-display text-3xl font-bold">الصفحة غير موجودة</h1>
        <p class="mt-1 text-text-muted">
          <span lang="en" dir="ltr">
            Page not found
          </span>
        </p>
        <p class="mt-4 max-w-md leading-7 text-text-muted">
          ربما نُقلت الصفحة أو تغيّر رابطها، أو في العنوان خطأ مطبعي. هذه أكثر الوجهات طلبًا:
        </p>
        <p class="mt-6 flex flex-wrap gap-3">
          <a
            href="/ar/"
            class="inline-flex rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-on-primary"
          >
            الرئيسية
          </a>
          <a
            href="/ar/contact/"
            class="inline-flex rounded-lg border border-border px-5 py-3 text-sm font-semibold"
          >
            أخبرنا عن الرابط
          </a>
        </p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {[
          ["القبول والتسجيل", "الخطوات والمواعيد والمستندات", "/ar/admissions/"],
          ["البرامج", "كل البرامج وحالة التقديم", "/ar/programs/"],
          ["تابع طلبك", "حالة طلب الالتحاق أو الاستفسار", `${PORTAL}/track`],
          ["دخول المنصة", "للطلاب وأعضاء هيئة التدريس", `${PORTAL}/login`],
        ].map(([title, hint, to]) => (
          <li>
            <a
              href={to}
              class="block h-full rounded-2xl border border-border-soft bg-surface p-5 hover:shadow-sm"
            >
              <b class="block text-text">{title}</b>
              <span class="mt-1 block text-sm text-text-muted">{hint}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

<script>
  // Old links the site team redirected in the CMS (DesktopSiteRedirects).
  const api = document.getElementById("not-found")!.dataset.api;
  fetch(`${api}/api/public/redirects?path=${encodeURIComponent(location.pathname)}`)
    .then((r) => (r.ok ? r.json() : null))
    .then((hit) => {
      if (hit?.to_path) location.replace(hit.to_path);
    })
    .catch(() => {});
</script>
