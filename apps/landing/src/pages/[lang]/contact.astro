---
import PageHead from "../../components/PageHead.astro";
import SideLinks from "../../components/SideLinks.astro";
import Base from "../../layouts/Base.astro";
import { API, PORTAL, departments, site } from "../../lib/api";
import { type Lang, isolateNumbers, langPaths, pick, t } from "../../lib/i18n";
import { related } from "../../lib/related";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const [s, depts] = await Promise.all([site(), departments()]);
const TYPES: [string, string, string][] = [
  ["admission", "القبول والتقديم", "Admission"],
  ["programs", "برنامج معين", "A program"],
  ["fees", "الرسوم والمنح", "Fees & scholarships"],
  ["registration", "التسجيل", "Registration"],
  ["study", "الدراسة", "Study"],
  ["technical", "مشكلة تقنية", "Technical issue"],
  ["general", "أخرى", "Other"],
];
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const hours = isolateNumbers(pick(lang, s.office_hours_ar ?? "", s.office_hours_en));
const quick = [
  ...(s.phone
    ? [{ label: L("اتصل", "Call"), value: s.phone, href: `tel:${s.phone.replace(/\s/g, "")}` }]
    : []),
  ...(s.whatsapp_e164
    ? [
        {
          label: "WhatsApp",
          value: s.whatsapp_e164,
          href: `https://wa.me/${s.whatsapp_e164.replace(/\D/g, "")}`,
          external: true,
        },
      ]
    : []),
  ...(s.email ? [{ label: L("البريد", "Email"), value: s.email, href: `mailto:${s.email}` }] : []),
];
// The college's own map link when set, else a search for the address.
const mapHref =
  s.map_url ||
  (s.address
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.address)}`
    : "");
// Answers people often look for before writing.
const answers = await related(lang, ["admissions", "fees", "programs", "calendar"]);
---

<Base lang={lang} title={t(lang, "contact")} path="contact/">
  <PageHead
    lang={lang}
    title={L("تواصل معنا", "Contact us")}
    lead={L(
      "يصل استفسارك إلى الجهة المختصة ويُرد عليه عادةً خلال يوم عمل. تتابع الرد برقمك المرجعي — لا حاجة لحساب.",
      "Your message reaches the right office, usually answered within a working day. Follow up with your reference number — no account needed.",
    )}
    crumbs={[[t(lang, "contact"), "contact/"]]}
  >
    {/* Call, chat or write in one tap before any form (W13); the hours say when someone answers. */}
    {quick.length > 0 && (
      <ul class="mt-5 grid gap-2 sm:flex sm:flex-wrap">
        {quick.map((q) => (
          <li>
            <a
              href={q.href}
              {...(q.external ? { rel: "noopener", target: "_blank" } : {})}
              class="flex min-h-12 items-center gap-3 rounded-xl border border-border-soft bg-surface px-4 py-2 text-sm hover:border-primary"
            >
              <span class="font-semibold">{q.label}</span>
              <bdi dir="ltr" class="ms-auto text-text-muted sm:ms-0">
                {q.value}
              </bdi>
            </a>
          </li>
        ))}
      </ul>
    )}
    {hours && (
      <p class="mt-3 text-sm text-text-muted">
        {L("ساعات العمل:", "Office hours:")} <span class="font-semibold text-text">{hours}</span>
      </p>
    )}
  </PageHead>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[2fr_1fr] lg:px-8">
    <form id="contact" data-api={API} data-lang={lang} class="space-y-5" novalidate>
      <fieldset>
        <legend class="text-sm font-semibold">{L("الموضوع", "Topic")}</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {TYPES.map(([value, ar, en], i) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="type"
                value={value}
                checked={i === 0}
                class="peer sr-only"
              />
              <span class="inline-block rounded-full border border-border-soft bg-surface px-3 py-1.5 text-sm font-semibold peer-checked:bg-text peer-checked:text-bg peer-focus-visible:ring-2">
                {L(ar, en)}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-semibold">
          {L("الاسم الكامل", "Full name")}
          <input
            name="name"
            required
            maxlength="200"
            autocomplete="name"
            placeholder={L("الاسم كما في الشهادة", "Your full name")}
            aria-describedby="e-name"
            class="field"
          />
          <span id="e-name" class="field-error hidden"></span>
        </label>
        <label class="block text-sm font-semibold">
          {L("البريد الإلكتروني", "Email")}
          <input
            name="email"
            type="email"
            autocomplete="email"
            dir="ltr"
            placeholder="name@example.com"
            aria-describedby="e-email"
            class="field"
          />
          <span id="e-email" class="field-error hidden"></span>
        </label>
        <label class="block text-sm font-semibold">
          {L("الهاتف (واتساب إن أمكن)", "Phone (WhatsApp if possible)")}
          <input
            name="phone"
            type="tel"
            autocomplete="tel"
            dir="ltr"
            placeholder="+249…"
            aria-describedby="e-phone"
            class="field"
          />
          <span id="e-phone" class="field-error hidden"></span>
        </label>
        <label class="block text-sm font-semibold">
          {L("القسم", "Department")}
          <select name="department" class="field">
            <option value="">{L("غير محدد", "Not specific")}</option>
            {depts.map((d) => (
              <option value={d.id}>{pick(lang, d.name_ar, d.name_en)}</option>
            ))}
          </select>
        </label>
      </div>
      <label class="block text-sm font-semibold">
        {L("عنوان الاستفسار", "Subject")}
        <input
          name="subject"
          required
          maxlength="200"
          placeholder={L(
            "مثال: شروط القبول في تقنية المعلومات",
            "e.g. Admission requirements for IT",
          )}
          aria-describedby="e-subject"
          class="field"
        />
        <span id="e-subject" class="field-error hidden"></span>
      </label>
      <label class="block text-sm font-semibold">
        {L("رسالتك", "Message")}
        <textarea
          name="message"
          required
          maxlength="4000"
          rows="6"
          placeholder={L(
            "اكتب سؤالك بالتفصيل — كلما كان أوضح كان الرد أسرع.",
            "Write your question in detail — the clearer it is, the faster the reply.",
          )}
          aria-describedby="e-message"
          class="field"
        ></textarea>
        <span id="e-message" class="field-error hidden"></span>
      </label>
      <!-- Bots fill hidden fields; people never see this one. -->
      <label class="hidden" aria-hidden="true">
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
      <p
        id="contact-error"
        role="alert"
        class="hidden rounded-lg bg-danger-soft p-3 text-sm text-danger-strong"
      ></p>
      <button
        type="submit"
        class="min-h-12 w-full rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-hover disabled:opacity-60 sm:w-auto"
      >
        {L("إرسال الاستفسار", "Send your question")}
      </button>
      <div
        id="contact-done"
        tabindex="-1"
        role="status"
        class="hidden rounded-2xl bg-success-soft p-5 text-success-strong"
      >
        <p class="flex items-center gap-3 font-bold">
          {/* Draws itself when the box appears (motion.css .motion-check). */}
          <span
            class="motion-check grid size-10 shrink-0 place-items-center rounded-full bg-surface"
            aria-hidden="true"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 12.5l4.2 4.2L19 7"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="--len: 22"
              ></path>
            </svg>
          </span>
          {L("وصل استفسارك.", "We received your message.")}
        </p>
        <p class="mt-1 text-sm">
          {L("الرقم المرجعي — احتفظ به:", "Your reference number — keep it:")}{" "}
          <b id="contact-ref" dir="ltr" class="font-mono text-lg"></b>
        </p>
        <p class="mt-2 text-sm leading-6">
          {L(
            "يصلك الرد على البريد أو الهاتف الذي كتبته. تحقق من حالته في أي وقت برقمه من «سبق أن راسلتنا؟».",
            "The reply reaches the email or phone you gave. Check its status any time with the number under «Already wrote to us?».",
          )}
        </p>
        <a
          id="contact-track"
          href={`${PORTAL}/track`}
          class="mt-3 hidden text-sm font-semibold underline"
        >
          {L("أو تابع كل طلباتك ببريدك", "Or follow everything with your email")}
        </a>
      </div>
    </form>
    <aside class="space-y-3 text-sm lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-2xl border border-border-soft bg-surface p-4 leading-6">
        <b class="block">{L("سبق أن راسلتنا؟", "Already wrote to us?")}</b>
        {/* Works for everyone, also those who wrote with a phone only (the portal's
            «تابع طلبك» needs an email). The API shows the status only — no names. */}
        <form id="status" data-api={API} class="mt-2 flex gap-2" novalidate>
          <label for="status-ref" class="sr-only">
            {L("الرقم المرجعي", "Reference number")}
          </label>
          <input
            id="status-ref"
            name="ref"
            dir="ltr"
            required
            autocomplete="off"
            placeholder="INQ-26-A1B2C3"
            class="field !mt-0 min-w-0 flex-1 font-mono uppercase"
          />
          <button
            type="submit"
            class="shrink-0 rounded-lg border border-border px-3 font-semibold text-text hover:bg-surface-alt"
          >
            {L("تحقق", "Check")}
          </button>
        </form>
        <p id="status-result" role="status" class="mt-2 hidden"></p>
        <a href={`${PORTAL}/track`} class="mt-2 inline-block font-semibold text-primary">
          {L("أو تابع كل طلباتك ببريدك", "Or follow everything with your email")}
        </a>
      </div>
      <SideLinks
        lang={lang}
        title={L("قد تجد إجابتك هنا", "Your answer may be here")}
        links={answers}
      />
      {s.address && (
        <div class="rounded-2xl bg-bg-subtle p-4">
          <span class="text-text-muted">{L("العنوان", "Address")}</span>
          <b class="block">{s.address}</b>
          {/* A link, not an embedded map: light, private, and no coordinates to invent. */}
          <a
            href={mapHref}
            rel="noopener"
            target="_blank"
            class="mt-2 inline-block font-semibold text-primary"
          >
            {L("افتح في الخرائط", "Open in Maps")}
          </a>
        </div>
      )}
    </aside>
  </div>
</Base>

<style>
  .field-error {
    margin-top: 0.25rem;
    display: block;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-danger-strong);
  }
  .field-error.hidden {
    display: none;
  }
  .field[aria-invalid="true"] {
    border-color: var(--color-danger);
  }
  .field {
    margin-top: 0.375rem;
    display: block;
    width: 100%;
    min-height: 2.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.5rem 0.75rem;
    font-weight: 400;
  }
</style>

<script>
  const form = document.getElementById("contact") as HTMLFormElement;
  const error = document.getElementById("contact-error")!;
  const ar = form.dataset.lang === "ar";
  const FIELDS = ["name", "email", "phone", "subject", "message"];

  /** Marks each field with its problem; focuses the first. True when there is any. */
  function showErrors(problems: Record<string, string>): boolean {
    let first: HTMLElement | null = null;
    for (const name of FIELDS) {
      const input = form.elements.namedItem(name) as HTMLElement | null;
      const note = document.getElementById(`e-${name}`);
      if (!input || !note) continue;
      if (problems[name]) {
        note.textContent = problems[name];
        note.classList.remove("hidden");
        input.setAttribute("aria-invalid", "true");
        first ??= input;
      } else {
        note.classList.add("hidden");
        input.removeAttribute("aria-invalid");
      }
    }
    first?.focus();
    return first !== null;
  }
  const flatten = (errors: Record<string, string[] | string>) =>
    Object.fromEntries(
      Object.entries(errors).map(([k, v]) => [k, Array.isArray(v) ? v.join(" ") : String(v)]),
    );
  // A field's note clears as soon as it is edited.
  form.addEventListener("input", (event) => {
    const input = event.target as HTMLElement & { name?: string };
    if (!input.name) return;
    input.removeAttribute("aria-invalid");
    document.getElementById(`e-${input.name}`)?.classList.add("hidden");
    if (input.name === "phone") {
      // A phone also satisfies «email or phone».
      (form.elements.namedItem("email") as HTMLElement).removeAttribute("aria-invalid");
      document.getElementById("e-email")?.classList.add("hidden");
    }
  });
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    error.classList.add("hidden");
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    // Each field says what is missing, next to it (UX review #9).
    const problems: Record<string, string> = {};
    const email = form.elements.namedItem("email") as HTMLInputElement;
    if (!data.name?.trim()) problems.name = ar ? "اكتب اسمك." : "Enter your name.";
    if (data.email && !email.checkValidity())
      problems.email = ar ? "البريد غير صحيح — مثل name@example.com" : "Not a valid email.";
    else if (!data.email && !data.phone?.trim())
      problems.email = ar
        ? "أعطنا بريدًا أو هاتفًا لنرد عليك."
        : "Give an email or a phone for the reply.";
    if (!data.subject?.trim())
      problems.subject = ar ? "اكتب عنوانًا قصيرًا لسؤالك." : "Add a short subject.";
    if (!data.message?.trim()) problems.message = ar ? "اكتب رسالتك." : "Write your message.";
    if (showErrors(problems)) return;
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;
    try {
      const response = await fetch(`${form.dataset.api}/api/public/inquiries`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept-Language": ar ? "ar" : "en" },
        body: JSON.stringify({
          ...data,
          department: data.department ? Number(data.department) : null,
        }),
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok && body.errors && showErrors(flatten(body.errors))) {
        button.disabled = false;
        return;
      }
      if (!response.ok)
        throw new Error(
          body.detail ||
            (response.status === 429
              ? ar
                ? "طلبات كثيرة، حاول لاحقًا."
                : "Too many requests, try later."
              : ""),
        );
      document.getElementById("contact-ref")!.textContent = body.reference_no;
      // The portal's follow-up works by email; with a phone only, the reference is the way.
      document.getElementById("contact-track")!.classList.toggle("hidden", !data.email);
      form
        .querySelectorAll("fieldset, label, button[type=submit]")
        .forEach((el) => el.classList.add("hidden"));
      const done = document.getElementById("contact-done")!;
      done.classList.remove("hidden");
      done.focus();
    } catch (e) {
      error.textContent =
        (e as Error).message ||
        (ar
          ? "تعذّر الإرسال. تحقق من الاتصال وأعد المحاولة."
          : "Could not send. Check your connection and retry.");
      error.classList.remove("hidden");
      button.disabled = false;
    }
  });

  // «سبق أن راسلتنا؟»: the status of an inquiry by its reference number.
  const statusForm = document.getElementById("status") as HTMLFormElement;
  const statusResult = document.getElementById("status-result")!;
  statusForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const ref = (new FormData(statusForm).get("ref") as string).trim().toUpperCase();
    const show = (text: string, ok: boolean) => {
      statusResult.textContent = text;
      statusResult.className = `mt-2 font-semibold ${ok ? "text-success-strong" : "text-danger-strong"}`;
    };
    if (!/^INQ-\d{2}-[0-9A-F]{6}$/.test(ref))
      return show(
        ar
          ? "اكتب الرقم كما وصلك، مثل INQ-26-A1B2C3."
          : "Type the number as you got it, e.g. INQ-26-A1B2C3.",
        false,
      );
    try {
      const response = await fetch(
        `${statusForm.dataset.api}/api/public/inquiries/${encodeURIComponent(ref)}`,
        { headers: { "Accept-Language": ar ? "ar" : "en" } },
      );
      if (response.status === 404)
        return show(ar ? "لا يوجد استفسار بهذا الرقم." : "No inquiry has this number.", false);
      if (response.status === 429)
        return show(ar ? "محاولات كثيرة، حاول لاحقًا." : "Too many tries, try later.", false);
      const body = await response.json();
      show(`${body.reference_no}: ${body.status_label}`, true);
    } catch {
      show(ar ? "تعذّر الاتصال. أعد المحاولة." : "Could not connect. Try again.", false);
    }
  });
</script>
