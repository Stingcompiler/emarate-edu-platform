---
import ArabicOnly from "../../../components/ArabicOnly.astro";
import PageHead from "../../../components/PageHead.astro";
import SideLinks from "../../../components/SideLinks.astro";
import WithAside from "../../../components/WithAside.astro";
import Base from "../../../layouts/Base.astro";
import { type News, get, news } from "../../../lib/api";
import { LANGS, type Lang, fmtDate, href, t, isArabic } from "../../../lib/i18n";
import { related } from "../../../lib/related";

export async function getStaticPaths() {
  const items = await news();
  const full = await Promise.all(
    items.map((n) => get<News | null>(`news/${encodeURIComponent(n.slug)}`, null)),
  );
  return LANGS.flatMap((lang) =>
    full
      .filter((n): n is News => !!n)
      .map((n) => ({ params: { lang, slug: n.slug }, props: { item: n } })),
  );
}
const lang = Astro.params.lang as Lang;
const { item: n } = Astro.props as { item: News };
const others = (await news())
  .filter((o) => o.slug !== n.slug)
  .slice(0, 5)
  .map((o) => ({
    label: o.title,
    href: href(lang, `news/${o.slug}/`),
    meta: o.publish_at ? fmtDate(lang, o.publish_at) : undefined,
  }));
const more = await related(lang, ["events", "announcements"]);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: n.title,
  description: n.summary || undefined,
  datePublished: n.publish_at ?? undefined,
  image: n.cover_url ? [n.cover_url] : undefined,
  publisher: { "@type": "CollegeOrUniversity", name: "كلية الإمارات للعلوم والتكنولوجيا" },
};
---

<Base
  lang={lang}
  title={n.title}
  path={`news/${n.slug}/`}
  description={n.summary}
  jsonLd={jsonLd}
  image={n.cover_url}
>
  <PageHead
    lang={lang}
    title={n.title}
    lead={n.publish_at ? fmtDate(lang, n.publish_at) : undefined}
    crumbs={[[t(lang, "news"), "news/"]]}
  />
  <WithAside>
    <article class="max-w-3xl">
      {n.cover_url && (
        <img data-reveal="image" src={n.cover_url} alt="" class="mb-8 w-full rounded-2xl" />
      )}
      <ArabicOnly lang={lang} when={isArabic(n.body)}>
        <div class="space-y-4 text-base leading-8" set:html={n.body} />
      </ArabicOnly>
    </article>
    <Fragment slot="aside">
      <SideLinks lang={lang} title={lang === "ar" ? "أخبار أخرى" : "More news"} links={others} />
      <SideLinks lang={lang} title={lang === "ar" ? "ذو صلة" : "Related"} links={more} />
    </Fragment>
  </WithAside>
</Base>
