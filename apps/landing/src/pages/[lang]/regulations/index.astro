---
import PageHead from "../../../components/PageHead.astro";
import SideLinks from "../../../components/SideLinks.astro";
import WithAside from "../../../components/WithAside.astro";
import Base from "../../../layouts/Base.astro";
import { API, regulations } from "../../../lib/api";
import { type Lang, fmtDate, langPaths } from "../../../lib/i18n";
import { related } from "../../../lib/related";

// docs/07 §1 `/regulations`: what student affairs publishes for everyone, by category.
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = (a: string, e: string) => (lang === "ar" ? a : e);
const items = await regulations();
const groups = [...new Map(items.map((r) => [r.category, r.category_label])).entries()];
const more = await related(lang, ["guide", "calendar", "affairs", "contact"]);
---

<Base lang={lang} title={L("اللوائح والأنظمة", "Regulations")} path="regulations/">
  <PageHead
    lang={lang}
    title={L("اللوائح والأنظمة", "Regulations")}
    lead={L(
      "اللوائح المعتمدة المنشورة للعموم — الإصدار الساري لكل لائحة.",
      "The college's published regulations — the version in force.",
    )}
    crumbs={[[L("اللوائح", "Regulations"), "regulations/"]]}
  />
  <WithAside>
    {groups.map(([key, label]) => (
      <section id={`c-${key}`} class="mb-10 scroll-mt-24">
        <h2 class="font-display text-xl font-bold">{label}</h2>
        <ul
          class:list={[
            "mt-3 grid items-start gap-3",
            items.filter((r) => r.category === key).length > 1 && "xl:grid-cols-2",
          ]}
        >
          {items
            .filter((r) => r.category === key)
            .map((r) => (
              <li class="rounded-2xl border border-border-soft bg-surface p-4">
                <b class="block text-text">{r.title}</b>
                <span class="text-xs text-text-muted">
                  {L("الإصدار", "Version")} {r.version}
                  {r.effective_from &&
                    ` · ${L("يسري من", "In force from")} ${fmtDate(lang, r.effective_from)}`}
                </span>
                {r.body && (
                  <details class="group mt-2">
                    {/* Its own chevron: the browser's ◄ marker points the wrong way in RTL. */}
                    <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 py-2 text-sm font-semibold text-primary [&::-webkit-details-marker]:hidden">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        aria-hidden="true"
                        class="transition-transform group-open:rotate-90 rtl:-scale-x-100 rtl:group-open:-rotate-90"
                      >
                        <path d="M9 6l6 6-6 6" />
                      </svg>
                      {L("اقرأ النص", "Read the text")}
                    </summary>
                    <p class="whitespace-pre-line text-sm leading-7">{r.body}</p>
                  </details>
                )}
                {r.has_file && (
                  <a
                    href={`${API}/api/public/regulations/${r.public_id}/file`}
                    class="mt-2 inline-block text-sm font-semibold text-primary"
                  >
                    {L("تنزيل ملف PDF", "Download the PDF")}
                  </a>
                )}
              </li>
            ))}
        </ul>
      </section>
    ))}
    {!items.length && (
      <p class="text-sm text-text-muted">
        {L("لا لوائح منشورة للعموم بعد.", "No public regulations yet.")}
      </p>
    )}
    <Fragment slot="aside">
      {groups.length > 1 && (
        <SideLinks
          lang={lang}
          title={L("التصنيفات", "Categories")}
          links={groups.map(([key, label]) => ({
            label,
            href: `#c-${key}`,
          }))}
        />
      )}
      <SideLinks lang={lang} title={L("ذو صلة", "Related")} links={more} />
    </Fragment>
  </WithAside>
</Base>
