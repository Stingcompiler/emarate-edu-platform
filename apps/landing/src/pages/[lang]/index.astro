---
import ProgramCard from "../../components/ProgramCard.astro";
import StaffCard from "../../components/StaffCard.astro";
import { HERO_WIDTHS } from "../../lib/images";
import TrustStrip from "../../components/TrustStrip.astro";
import Base from "../../layouts/Base.astro";
import {
  PORTAL,
  announcements,
  departments,
  staff,
  events,
  news,
  page,
  programs,
  site,
  stats,
} from "../../lib/api";
import {
  arrow,
  cycleName,
  degree,
  fmtDate,
  href,
  type Lang,
  langPaths,
  num,
  pick,
  t,
  count,
  N,
} from "../../lib/i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const [s, all, st, upcoming, latest, depts, notes, dean, members] = await Promise.all([
  site(),
  programs(),
  stats(),
  events(),
  news(),
  departments(),
  announcements(),
  page("about/dean"), // shown here once the site manager publishes it
  staff(),
]);
const deanWords = (dean?.blocks ?? [])
  .filter((b) => b.type === "paragraph" && b.text)
  .map((b) => b.text!)
  .join(" ");
const deanExcerpt = deanWords.length > 280 ? `${deanWords.slice(0, 280).trimEnd()}…` : deanWords;
const deanPhoto = dean?.blocks.find((b) => b.type === "image" && b.url);
const pinned = notes.filter((a) => a.is_pinned).slice(0, 2);
const open = all.filter((p) => p.intake?.accepting);
const closes = open.map((p) => p.intake!.closes_at).sort()[0];
const daysLeft = closes
  ? Math.max(0, Math.ceil((new Date(closes).getTime() - Date.now()) / 86400000))
  : null;
const cycle = open[0]?.intake ? cycleName(lang, open[0].intake.cycle) : undefined;
const next = upcoming
  .filter((e) => new Date(e.ends_at) > new Date())
  .sort((a, b) => a.starts_at.localeCompare(b.starts_at))[0];
const name = pick(lang, s.name_ar, s.name_en);
const lead =
  lang === "ar"
    ? `تعليم تقني يبدأ من هنا: ${count(lang, st.departments, N.department)}، وتقديم إلكتروني بالكامل ومتابعة للطلب من هاتفك.`
    : `Technical education starts here: ${count(lang, st.departments, N.department)}, a fully online application you can follow from your phone.`;
// What search results show for the home (review: the name alone, and a 55-character
// description, left the page's subject to guesswork): the degrees offered, and the owner's
// own description completed with the programme and department counts when it is short.
const degrees = [
  ...new Set(all.map((p) => degree(lang, p.degree, p.degree_label)).filter(Boolean)),
];
const seoTitle = degrees.length
  ? lang === "ar"
    ? `${name} — برامج ${degrees.join(" و")}`
    : `${name} — ${degrees.join(" and ")} programmes`
  : undefined;
const ownDescription = s.seo?.description || s.tagline || "";
const homeDescription =
  ownDescription.length >= 80
    ? ownDescription
    : ownDescription
      ? `${ownDescription.replace(/[.،]+$/, "")}. ${lead}`
      : `${name} — ${lead}`;
// «11 برنامجًا بكالوريوس ودبلوم — قدّم من هاتفك في دقائق»: what is offered, to whom, how (design
// review B4); the numbers and degrees come from the data. «تعليم تقني يبدأ من هنا» stays as the
// supporting line.
const programCount = st.programs || all.length;
const heroLines =
  lang === "ar"
    ? [
        `${count(lang, programCount, N.program)}${degrees.length ? ` ${degrees.join(" و")}` : ""}`,
        "قدّم من هاتفك في دقائق.",
      ]
    : [
        `${count(lang, programCount, N.program)}${degrees.length ? `: ${degrees.join(" and ")}` : ""}`,
        "apply from your phone in minutes.",
      ];
const heroSet = (format: "avif" | "webp") =>
  HERO_WIDTHS.map((width) => `/img/hero-${width}.${format} ${width}w`).join(", ");
const heroSizes = "(min-width: 1280px) 560px, (min-width: 1024px) 45vw, 100vw";
// Applicants, students, parents (lucide graduation-cap, user-round, users), drawn inline.
const AUDIENCE_ICONS = [
  '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
];
const audiences =
  lang === "ar"
    ? [
        {
          title: "للمتقدمين",
          links: [
            ["خطوات القبول ومواعيده", href(lang, "admissions/")],
            ["البرامج وشروطها", href(lang, "programs/")],
            ["الرسوم والمنح", href(lang, "admissions/fees/")],
            ["تابع طلبك", `${PORTAL}/track`],
          ],
        },
        {
          title: "لطلاب الكلية",
          links: [
            ["دخول المنصة", `${PORTAL}/login`],
            ["تطبيق البوابة على هاتفك", `${PORTAL}/install`],
            ["التقويم الأكاديمي", href(lang, "calendar/")],
            ["اللوائح والأنظمة", href(lang, "regulations/")],
            ["الإعلانات", href(lang, "announcements/")],
          ],
        },
        {
          title: "لأولياء الأمور",
          links: [
            ["دليل وليّ الأمر", href(lang, "parents/")],
            ["الاعتماد والاعتراف", href(lang, "about/accreditation/")],
            ["الرسوم والمنح", href(lang, "admissions/fees/")],
            ["تواصل معنا", href(lang, "contact/")],
          ],
        },
      ]
    : [
        {
          title: "Applicants",
          links: [
            ["Admission steps and dates", href(lang, "admissions/")],
            ["Programs and requirements", href(lang, "programs/")],
            ["Fees and grants", href(lang, "admissions/fees/")],
            ["Track your application", `${PORTAL}/track`],
          ],
        },
        {
          title: "Current students",
          links: [
            ["Sign in to the portal", `${PORTAL}/login`],
            ["The portal app on your phone", `${PORTAL}/install`],
            ["Academic calendar", href(lang, "calendar/")],
            ["Regulations", href(lang, "regulations/")],
            ["Announcements", href(lang, "announcements/")],
          ],
        },
        {
          title: "Parents",
          links: [
            ["A guide for parents", href(lang, "parents/")],
            ["Accreditation", href(lang, "about/accreditation/")],
            ["Fees and grants", href(lang, "admissions/fees/")],
            ["Contact us", href(lang, "contact/")],
          ],
        },
      ];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollegeOrUniversity",
  name: s.name_ar,
  alternateName: s.name_en,
  url: Astro.site?.toString(),
  email: s.email || undefined,
  telephone: s.phone || undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: s.address || undefined,
    addressLocality: "الخرطوم",
    addressCountry: "SD",
  },
  sameAs: Object.values(s.social ?? {}).filter(Boolean),
  // Richer identity for search engines (review 2026-09-30).
  logo: s.logo_url || new URL("/favicon.svg", Astro.site).toString(),
  image: s.share_image_url || s.hero_image_url || undefined,
  foundingDate: s.founded_year ? String(s.founded_year) : undefined,
  description: homeDescription,
  contactPoint:
    s.phone || s.email
      ? {
          "@type": "ContactPoint",
          contactType: "admissions",
          telephone: s.phone || undefined,
          email: s.email || undefined,
          availableLanguage: ["ar", "en"],
        }
      : undefined,
};
---

<Base
  lang={lang}
  title={name}
  seoTitle={seoTitle}
  description={homeDescription}
  jsonLd={jsonLd}
  overHero
>
  <section class="bg-bg-subtle">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 pb-10 pt-24 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:px-8 lg:pb-12 lg:pt-28">
      <div>
        {cycle && (
          <p class="inline-flex rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent-700">
            {lang === "ar" ? `القبول مفتوح · ${cycle}` : `${cycle} · open`}
          </p>
        )}
        {/* One action, one colour (design review B4): «قدّم الآن» in the accent red, repeated in the
            header and the closing call; exploring and tracking are plain text links. */}
        <h1 class="motion-lines mt-4 font-display text-3xl font-bold leading-snug text-text sm:text-4xl">
          {heroLines.map((line) => (
            <span>
              <span>{line}</span>
            </span>
          ))}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-7 text-text-muted">{lead}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          {open.length > 0 ? (
            <a
              href={`${PORTAL}/apply`}
              class="tap-44 inline-flex items-center rounded-lg bg-accent px-6 py-3 text-sm font-bold text-on-primary hover:bg-accent-hover"
            >
              {t(lang, "apply")} {arrow(lang)}
            </a>
          ) : (
            <a
              href={href(lang, "programs/")}
              class="tap-44 inline-flex items-center rounded-lg border-2 border-primary px-6 py-3 text-sm font-bold text-primary hover:bg-primary-soft"
            >
              {t(lang, "explore")}
            </a>
          )}
          {open.length > 0 && (
            <a
              href={href(lang, "programs/")}
              class="tap-44 inline-flex items-center text-sm font-semibold text-primary underline-offset-4 hover:underline"
            >
              {t(lang, "explore")}
            </a>
          )}
          <a
            href={`${PORTAL}/track`}
            class="tap-44 inline-flex items-center text-sm font-semibold text-text-muted underline-offset-4 hover:text-text hover:underline"
          >
            {t(lang, "track")}
          </a>
        </div>
      </div>
      {s.hero_image_url && (
        // The college's own picture (campus, students): the page's priority image, beside the
        // words on large screens (mockups 2026-10-29). AVIF, else WebP, at the width the screen
        // needs; the upload itself is the last resort (design review B6).
        <picture>
          <source type="image/avif" srcset={heroSet("avif")} sizes={heroSizes} />
          <source type="image/webp" srcset={heroSet("webp")} sizes={heroSizes} />
          <img
            src={s.hero_image_url}
            alt={s.hero_image_alt_ar ?? ""}
            width="1200"
            height="514"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/3] w-full rounded-3xl object-cover"
          />
        </picture>
      )}
      {daysLeft !== null && (
        <div
          class={`rounded-2xl bg-header p-6 text-white shadow-lg lg:p-8 ${s.hero_image_url ? "lg:col-span-2 lg:flex lg:items-center lg:gap-10" : ""}`}
        >
          <div class="lg:shrink-0">
            <p class="text-sm text-navy-200">
              {lang === "ar"
                ? `يُغلق التقديم بعد ${daysLeft === 1 ? "يوم" : count(lang, daysLeft, N.day)}`
                : `Applications close in ${daysLeft} days`}
              {closes && ` · ${fmtDate(lang, closes, { day: "numeric", month: "long" })}`}
            </p>
            <p class="mt-1 font-display text-2xl font-bold">
              {lang === "ar"
                ? `${count(lang, open.length, N.program)} تقبل الآن`
                : `${open.length} programmes open now`}
            </p>
          </div>
          <ol
            class={`mt-5 hidden space-y-2 text-sm text-navy-100 lg:block ${s.hero_image_url ? "lg:mt-0 lg:flex lg:flex-1 lg:gap-6 lg:space-y-0" : ""}`}
          >
            {(lang === "ar"
              ? ["تحقّق من بريدك", "اختر البرنامج", "أكمل النموذج وارفع المستندات"]
              : ["Verify your email", "Choose a programme", "Fill in the form and upload"]
            ).map((step, i) => (
              <li class="flex items-center gap-3">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-white/15 text-xs font-bold">
                  {num(lang, i + 1)}
                </span>
                {step}
              </li>
            ))}
          </ol>
          <a
            href={href(lang, "admissions/")}
            class="tap-44 mt-6 inline-flex shrink-0 items-center text-sm font-semibold text-white underline underline-offset-4 lg:mt-0"
          >
            {lang === "ar" ? "كيف تلتحق" : "How to apply"} {arrow(lang)}
          </a>
        </div>
      )}
    </div>
    {/* The licence and the college's own figures — not portal account counts (review 2026-09-30). */}
    <TrustStrip
      lang={lang}
      site={s}
      programs={st.programs || all.length}
      departments={st.departments || depts.length}
      class="pb-10"
    />
  </section>

  {pinned.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pt-8 lg:px-8" aria-label={t(lang, "announcements")}>
      <ul class="space-y-2">
        {pinned.map((a) => (
          <li>
            <a
              href={href(lang, `announcements/${a.public_id}/`)}
              class="flex items-center gap-3 rounded-2xl border border-accent-soft bg-accent-soft/40 px-4 py-3 hover:bg-accent-soft"
            >
              <span class="rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-on-primary">
                {lang === "ar" ? "إعلان" : "Notice"}
              </span>
              <b class="min-w-0 flex-1 truncate text-sm text-text">{a.title}</b>
              <span class="text-sm text-primary">{arrow(lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* Who is visiting (review 2026-09-30; benchmark: Khalifa, PSUT): each finds their door. */}
  <section
    class="mx-auto max-w-6xl px-4 pt-10 lg:px-8"
    aria-label={lang === "ar" ? "طرق مختصرة" : "Shortcuts"}
  >
    <div class="grid gap-3 md:grid-cols-3">
      {audiences.map((a, i) => (
        <div
          data-reveal
          style={`--i:${i}`}
          class="rounded-2xl border border-border-soft bg-surface p-5"
        >
          <h2 class="flex items-center gap-3 text-lg font-bold">
            <svg
              class="size-6 shrink-0 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={AUDIENCE_ICONS[i]}
            />
            {a.title}
          </h2>
          <ul class="mt-3 space-y-1">
            {a.links.map(([label, url]) => (
              <li>
                <a
                  href={url}
                  class="flex min-h-11 items-center justify-between rounded-lg px-2 text-sm font-semibold text-primary hover:bg-surface-alt"
                >
                  {label}
                  <span aria-hidden="true">{arrow(lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* The portal as an app on the phone (owner, 2026-10-30). It installs from the portal's own
      address (a browser installs an app only from its origin): the button opens the portal's
      install page, which guides iPhone and Android and asks to sign in first. */}
  <section class="mx-auto max-w-6xl px-4 pt-10 lg:px-8" aria-labelledby="app-band">
    <div class="flex flex-col gap-5 rounded-2xl bg-header p-6 text-white lg:flex-row lg:items-center lg:gap-10 lg:p-8">
      <div class="flex-1">
        <h2 id="app-band" class="font-display text-2xl font-bold">
          {lang === "ar" ? "بوابة الكلية تطبيقًا على هاتفك" : "The college portal as an app"}
        </h2>
        <p class="mt-2 text-sm leading-6 text-navy-100">
          {lang === "ar"
            ? "ثبّتها من المتصفح دون متجر تطبيقات: تصلك الإشعارات فور نشر محاضرة أو نتيجة، وتفتح بلمسة من الشاشة الرئيسية، ويُحفظ ما تكتبه حين ينقطع الاتصال."
            : "Install it from the browser, no app store: notifications as soon as a lecture or result is published, one tap from the home screen, and what you write is kept when the connection drops."}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={`${PORTAL}/install`}
          class="tap-44 inline-flex items-center rounded-lg bg-white px-5 py-3 text-sm font-bold text-navy-500 hover:bg-navy-50"
        >
          {lang === "ar" ? "ثبّت التطبيق" : "Install the app"}
        </a>
        <span class="text-xs text-navy-200">
          {lang === "ar"
            ? "iPhone وAndroid · لطلاب الكلية ومنسوبيها"
            : "iPhone and Android · students and staff"}
        </span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-10 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-2xl font-bold">{t(lang, "departments")}</h2>
      <a href={href(lang, "departments/")} class="tap-44 text-sm font-semibold text-primary">
        {t(lang, "all")} · {num(lang, depts.length)}
      </a>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {depts.map((d, i) => (
        <a
          data-reveal
          style={`--i:${i}`}
          href={href(lang, `departments/${d.code}/`)}
          class="motion-lift rounded-2xl border border-border-soft bg-surface p-4"
        >
          <b class="block text-text">{pick(lang, d.name_ar, d.name_en)}</b>
          <span class="text-xs text-text-muted">{count(lang, d.programs.length, N.program)}</span>
        </a>
      ))}
    </div>
  </section>

  {/* «الكوادر» (owner, 2026-10-30): members who chose to appear; a card opens their page. */}
  {members.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pt-10 lg:px-8" aria-labelledby="staff-home">
      <div class="flex items-end justify-between">
        <h2 id="staff-home" class="font-display text-2xl font-bold">
          {t(lang, "staff")}
        </h2>
        <a href={href(lang, "staff/")} class="tap-44 text-sm font-semibold text-primary">
          {t(lang, "all")} · {num(lang, members.length)}
        </a>
      </div>
      <p class="mt-1 max-w-2xl text-sm text-text-muted">
        {(lang === "en" ? s.staff_intro_en : s.staff_intro_ar) || t(lang, "staffLead")}
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {members.slice(0, 4).map((m, i) => (
          <li>
            <StaffCard lang={lang} member={m} index={i} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 pt-10 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-2xl font-bold">{t(lang, "openPrograms")}</h2>
      <a href={href(lang, "programs/")} class="tap-44 text-sm font-semibold text-primary">
        {t(lang, "all")} · {num(lang, all.length)}
      </a>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {(open.length ? open : all).slice(0, 4).map((p) => (
        <ProgramCard lang={lang} program={p} />
      ))}
    </div>
  </section>

  {dean && deanExcerpt && (
    <section class="mx-auto max-w-6xl px-4 pt-12 lg:px-8">
      <div class="flex flex-col gap-5 rounded-2xl bg-bg-subtle p-5 sm:flex-row sm:items-start lg:p-8">
        {deanPhoto && (
          <img
            data-reveal="image"
            src={deanPhoto.url}
            alt={deanPhoto.alt ?? ""}
            loading="lazy"
            class="size-24 shrink-0 rounded-full object-cover"
          />
        )}
        <div>
          <h2 class="font-display text-2xl font-bold">
            {pick(lang, dean.title_ar, dean.title_en)}
          </h2>
          <p class="mt-2 max-w-3xl leading-8 text-text-muted">{deanExcerpt}</p>
          <a
            href={href(lang, "about/dean/")}
            class="tap-44 mt-3 inline-block text-sm font-semibold text-primary"
          >
            {lang === "ar" ? "اقرأ الكلمة كاملة" : "Read the full welcome"} {arrow(lang)}
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Nothing empty on show (review 2026-09-30): no news → the event (or nothing) instead. */}
  {(next || latest.length > 0) && (
    <section
      class:list={[
        "mx-auto grid max-w-6xl gap-8 px-4 pt-12 lg:px-8",
        next && latest.length > 0 && "lg:grid-cols-[1fr_2fr]",
      ]}
    >
      {next && (
        <div>
          <h2 class="font-display text-2xl font-bold">{t(lang, "upcoming")}</h2>
          {next ? (
            <a
              href={href(lang, `events/${next.slug}/`)}
              class="mt-4 flex gap-4 rounded-2xl border border-border-soft bg-surface p-4 hover:shadow-sm"
            >
              <!-- ui-allow: date block -->
              <span class="grid w-16 shrink-0 place-items-center rounded-xl bg-primary-soft py-2 text-center text-primary-700">
                <b class="block text-2xl">{fmtDate(lang, next.starts_at, { day: "numeric" })}</b>
                <span class="text-xs">{fmtDate(lang, next.starts_at, { month: "long" })}</span>
              </span>
              <span>
                <b class="block text-text">{next.title}</b>
                <span class="text-sm text-text-muted">
                  {fmtDate(lang, next.starts_at, {
                    weekday: "long",
                    hour: "numeric",
                    minute: "2-digit",
                  })}
                  {next.location ? ` · ${next.location}` : ""}
                </span>
              </span>
            </a>
          ) : null}
        </div>
      )}
      {latest.length > 0 && (
        <div>
          <div class="flex items-end justify-between">
            <h2 class="font-display text-2xl font-bold">{t(lang, "latestNews")}</h2>
            <a href={href(lang, "news/")} class="tap-44 text-sm font-semibold text-primary">
              {t(lang, "all")}
            </a>
          </div>
          <ul class="mt-4 divide-y divide-border-soft rounded-2xl border border-border-soft bg-surface">
            {latest.slice(0, 3).map((n) => (
              <li>
                <a
                  href={href(lang, `news/${n.slug}/`)}
                  class="flex gap-3 px-4 py-3 hover:bg-surface-alt"
                >
                  {n.cover_url && (
                    <img
                      data-reveal="image"
                      src={n.cover_url}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="size-16 shrink-0 rounded-lg object-cover"
                    />
                  )}
                  <span class="min-w-0">
                    {n.publish_at && (
                      <span class="block text-xs text-text-muted">
                        {fmtDate(lang, n.publish_at)}
                      </span>
                    )}
                    <b class="block text-text">{n.title}</b>
                    {n.summary && (
                      <span class="mt-0.5 line-clamp-2 block text-sm leading-6 text-text-muted">
                        {n.summary}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}
</Base>
