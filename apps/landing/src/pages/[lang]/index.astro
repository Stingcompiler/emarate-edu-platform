---
import ProgramCard from "../../components/ProgramCard.astro";
import Base from "../../layouts/Base.astro";
import { PORTAL, events, news, programs, site, stats } from "../../lib/api";
import { arrow, fmtDate, href, type Lang, langPaths, num, pick, t } from "../../lib/i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const [s, all, st, upcoming, latest] = await Promise.all([
  site(),
  programs(),
  stats(),
  events(),
  news(),
]);
const open = all.filter((p) => p.intake?.accepting);
const closes = open.map((p) => p.intake!.closes_at).sort()[0];
const daysLeft = closes
  ? Math.max(0, Math.ceil((new Date(closes).getTime() - Date.now()) / 86400000))
  : null;
const cycle = open[0]?.intake?.cycle;
const next = upcoming
  .filter((e) => new Date(e.ends_at) > new Date())
  .sort((a, b) => a.starts_at.localeCompare(b.starts_at))[0];
const name = pick(lang, s.name_ar, s.name_en);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollegeOrUniversity",
  name: s.name_ar,
  alternateName: s.name_en,
  url: Astro.site?.toString(),
  email: s.email || undefined,
  telephone: s.phone || undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: s.address || undefined,
    addressLocality: "الخرطوم",
    addressCountry: "SD",
  },
  sameAs: Object.values(s.social ?? {}),
};
---

<Base lang={lang} title={name} jsonLd={jsonLd}>
  <section class="bg-bg-subtle">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:px-8 lg:py-16">
      <div>
        {cycle && (
          <p class="inline-flex rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent-700">
            {lang === "ar" ? `القبول مفتوح · ${cycle}` : `Admission open · ${cycle}`}
          </p>
        )}
        <h1 class="mt-4 font-display text-4xl font-bold leading-snug text-text lg:text-5xl">
          {lang === "ar" ? (
            <>
              تعليم تقني
              <br />
              يبدأ من هنا.
            </>
          ) : (
            <>
              Technical education
              <br />
              starts here.
            </>
          )}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-7 text-text-muted">
          {lang === "ar"
            ? `${num(lang, st.programs || all.length)} برنامجًا في ${num(lang, st.departments)} أقسام — تقديم إلكتروني بالكامل ومتابعة للطلب من هاتفك.`
            : `${num(lang, st.programs || all.length)} programs in ${num(lang, st.departments)} departments — apply online and follow your application from your phone.`}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={href(lang, "programs/")}
            class="rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-hover"
          >
            {t(lang, "explore")}
          </a>
          <a
            href={`${PORTAL}/track`}
            class="rounded-lg border border-border bg-surface px-5 py-3 text-sm font-semibold text-text hover:bg-surface-alt"
          >
            {t(lang, "track")}
          </a>
        </div>
      </div>
      {daysLeft !== null && (
        <a
          href={`${PORTAL}/apply`}
          class="block rounded-2xl bg-header p-6 text-white shadow-lg hover:opacity-95"
        >
          <p class="text-sm text-navy-200">
            {lang === "ar"
              ? `يُغلق التقديم بعد ${num(lang, daysLeft)} يومًا`
              : `Applications close in ${daysLeft} days`}
          </p>
          <p class="mt-2 font-display text-2xl font-bold">
            {t(lang, "apply")} {arrow(lang)}
          </p>
        </a>
      )}
    </div>
    <div class="mx-auto grid max-w-6xl grid-cols-3 gap-2 px-4 pb-10 lg:px-8">
      {[
        [st.students, t(lang, "students")],
        [st.teachers, t(lang, "teachers")],
        [st.programs, t(lang, "programsCount")],
      ].map(([n, l]) => (
        <div class="rounded-2xl bg-surface p-4 text-center shadow-sm">
          <p class="font-display text-2xl font-bold text-primary">{num(lang, Number(n))}</p>
          <p class="text-xs text-text-muted">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-10 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-2xl font-bold">{t(lang, "openPrograms")}</h2>
      <a href={href(lang, "programs/")} class="text-sm font-semibold text-primary">
        {t(lang, "all")} · {num(lang, all.length)}
      </a>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {(open.length ? open : all).slice(0, 4).map((p) => (
        <ProgramCard lang={lang} program={p} />
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-4 pt-12 lg:grid-cols-[1fr_2fr] lg:px-8">
    <div>
      <h2 class="font-display text-xl font-bold">{t(lang, "upcoming")}</h2>
      {next ? (
        <a
          href={href(lang, `events/${next.slug}/`)}
          class="mt-4 flex gap-4 rounded-2xl border border-border-soft bg-surface p-4 hover:shadow-sm"
        >
          <span class="grid w-16 shrink-0 place-items-center rounded-xl bg-primary-soft py-2 text-center text-primary-700">
            <b class="block text-2xl">{fmtDate(lang, next.starts_at, { day: "numeric" })}</b>
            <span class="text-xs">{fmtDate(lang, next.starts_at, { month: "long" })}</span>
          </span>
          <span>
            <b class="block text-text">{next.title}</b>
            <span class="text-sm text-text-muted">
              {fmtDate(lang, next.starts_at, {
                weekday: "long",
                hour: "numeric",
                minute: "2-digit",
              })}
              {next.location ? ` · ${next.location}` : ""}
            </span>
          </span>
        </a>
      ) : (
        <p class="mt-4 text-sm text-text-muted">
          {lang === "ar" ? "لا فعاليات قادمة الآن." : "No upcoming events."}
        </p>
      )}
    </div>
    <div>
      <div class="flex items-end justify-between">
        <h2 class="font-display text-xl font-bold">{t(lang, "latestNews")}</h2>
        <a href={href(lang, "news/")} class="text-sm font-semibold text-primary">
          {t(lang, "all")}
        </a>
      </div>
      <ul class="mt-4 divide-y divide-border-soft rounded-2xl border border-border-soft bg-surface">
        {latest.slice(0, 3).map((n) => (
          <li>
            <a href={href(lang, `news/${n.slug}/`)} class="block px-4 py-3 hover:bg-surface-alt">
              <b class="block text-text">{n.title}</b>
              {n.publish_at && (
                <span class="text-xs text-text-muted">{fmtDate(lang, n.publish_at)}</span>
              )}
            </a>
          </li>
        ))}
        {!latest.length && (
          <li class="px-4 py-3 text-sm text-text-muted">
            {lang === "ar" ? "لا أخبار بعد." : "No news yet."}
          </li>
        )}
      </ul>
    </div>
  </section>
</Base>
