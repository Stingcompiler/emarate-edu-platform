---
import ArabicOnly from "../../../components/ArabicOnly.astro";
import PageHead from "../../../components/PageHead.astro";
import SideLinks from "../../../components/SideLinks.astro";
import WithAside from "../../../components/WithAside.astro";
import Base from "../../../layouts/Base.astro";
import { type Event, events, get, pastEvents, site } from "../../../lib/api";
import { LANGS, type Lang, fmtDate, fmtTime, href, t, isArabic } from "../../../lib/i18n";
import { related } from "../../../lib/related";

export async function getStaticPaths() {
  // Ended events keep their pages (docs/07 §1): only the lists move them to «past».
  const items = [...(await events()), ...(await pastEvents())];
  const full = await Promise.all(
    items.map((e) => get<Event | null>(`events/${encodeURIComponent(e.slug)}`, null)),
  );
  return LANGS.flatMap((lang) =>
    full
      .filter((e): e is Event => !!e)
      .map((e) => ({ params: { lang, slug: e.slug }, props: { item: e } })),
  );
}
const lang = Astro.params.lang as Lang;
const { item: e } = Astro.props as { item: Event };
const ended = new Date(e.ends_at) < new Date();
const when = fmtDate(lang, e.starts_at, {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
});
const others = (await events())
  .filter((o) => o.slug !== e.slug && new Date(o.ends_at) > new Date())
  .sort((x, y) => x.starts_at.localeCompare(y.starts_at))
  .slice(0, 4)
  .map((o) => ({
    label: o.title,
    href: href(lang, `events/${o.slug}/`),
    meta: fmtDate(lang, o.starts_at, { day: "numeric", month: "long" }),
  }));
const more = await related(lang, ["events", "calendar"]);
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const s = await site();
// The time the event ends, when it ends the same day («10:00 ص – 3:00 م»).
const sameDay = e.starts_at.slice(0, 10) === e.ends_at.slice(0, 10);
const until = sameDay ? fmtTime(lang, e.ends_at) : "";
// Directions to the college (the event's hall is on campus): its map link, else the address.
const directions =
  s.map_url ||
  (s.address
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.address)}`
    : "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: e.title,
  startDate: e.starts_at,
  endDate: e.ends_at,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: e.location || s.name_ar,
    address: s.address || "الخرطوم، السودان",
  },
  organizer: { "@type": "CollegeOrUniversity", name: s.name_ar, url: Astro.site?.toString() },
};
---

<Base lang={lang} title={e.title} path={`events/${e.slug}/`} jsonLd={jsonLd} image={e.cover_url}>
  <PageHead
    lang={lang}
    title={e.title}
    lead={`${when}${until ? ` – ${until}` : ""}${e.location ? ` · ${e.location}` : ""}`}
    crumbs={[[lang === "ar" ? "الفعاليات" : "Events", "events/"]]}
  >
    {ended && (
      <p class="mt-4 inline-block rounded-full bg-surface-alt px-3 py-1 text-xs font-semibold text-text-muted">
        {lang === "ar" ? "انتهت هذه الفعالية" : "This event has ended"}
      </p>
    )}
    {!ended && e.registration_url && (
      <a
        href={e.registration_url}
        class="mt-5 inline-flex rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-primary hover:bg-accent-hover"
      >
        {t(lang, "register")}
      </a>
    )}
  </PageHead>
  <WithAside>
    <article class="max-w-3xl">
      {e.cover_url && (
        <img data-reveal="image" src={e.cover_url} alt="" class="mb-8 w-full rounded-2xl" />
      )}
      <ArabicOnly lang={lang} when={isArabic(e.description)}>
        <div class="space-y-4 text-base leading-8" set:html={e.description} />
      </ArabicOnly>
    </article>
    <Fragment slot="aside">
      {/* W11: the date is in the page head; here is what to do with it. */}
      {!ended && (
        <div class="space-y-2 rounded-2xl border border-border-soft bg-surface p-4 text-sm">
          {e.registration_url && (
            <a
              href={e.registration_url}
              class="flex min-h-11 items-center justify-center rounded-xl bg-accent px-4 font-semibold text-on-primary hover:bg-accent-hover"
            >
              {t(lang, "register")}
            </a>
          )}
          <a
            href={`/events/${e.slug}.ics`}
            download={`${e.slug}.ics`}
            class="flex min-h-11 items-center justify-center rounded-xl border border-border px-4 font-semibold text-text hover:bg-surface-alt"
          >
            {L("أضف إلى التقويم", "Add to calendar")}
          </a>
          {directions && (
            <a
              href={directions}
              rel="noopener"
              target="_blank"
              class="flex min-h-11 items-center justify-center rounded-xl border border-border px-4 font-semibold text-text hover:bg-surface-alt"
            >
              {L("الاتجاهات إلى الكلية", "Directions to the college")}
            </a>
          )}
        </div>
      )}
      {ended && (
        <p class="rounded-2xl bg-bg-subtle p-4 text-sm text-text-muted">
          {L(
            "انتهت هذه الفعالية. تجد القادمة في صفحة الفعاليات.",
            "This event has ended; upcoming ones are on the events page.",
          )}
        </p>
      )}
      <SideLinks
        lang={lang}
        title={L("فعاليات قادمة أخرى", "Other upcoming events")}
        links={others}
      />
      <SideLinks lang={lang} title={L("ذو صلة", "Related")} links={more} />
    </Fragment>
  </WithAside>
</Base>
