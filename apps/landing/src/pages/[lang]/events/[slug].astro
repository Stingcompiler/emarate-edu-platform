---
import PageHead from "../../../components/PageHead.astro";
import SideLinks from "../../../components/SideLinks.astro";
import WithAside from "../../../components/WithAside.astro";
import Base from "../../../layouts/Base.astro";
import { type Event, events, get, pastEvents } from "../../../lib/api";
import { LANGS, type Lang, fmtDate, href, t } from "../../../lib/i18n";
import { related } from "../../../lib/related";

export async function getStaticPaths() {
  // Ended events keep their pages (docs/07 §1): only the lists move them to «past».
  const items = [...(await events()), ...(await pastEvents())];
  const full = await Promise.all(
    items.map((e) => get<Event | null>(`events/${encodeURIComponent(e.slug)}`, null)),
  );
  return LANGS.flatMap((lang) =>
    full
      .filter((e): e is Event => !!e)
      .map((e) => ({ params: { lang, slug: e.slug }, props: { item: e } })),
  );
}
const lang = Astro.params.lang as Lang;
const { item: e } = Astro.props as { item: Event };
const ended = new Date(e.ends_at) < new Date();
const when = fmtDate(lang, e.starts_at, {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
});
const others = (await events())
  .filter((o) => o.slug !== e.slug && new Date(o.ends_at) > new Date())
  .sort((x, y) => x.starts_at.localeCompare(y.starts_at))
  .slice(0, 4)
  .map((o) => ({
    label: o.title,
    href: href(lang, `events/${o.slug}/`),
    meta: fmtDate(lang, o.starts_at, { day: "numeric", month: "long" }),
  }));
const more = await related(lang, ["events", "calendar"]);
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: e.title,
  startDate: e.starts_at,
  endDate: e.ends_at,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: e.location || "كلية الإمارات للعلوم والتقنية",
    address: "الخرطوم، السودان",
  },
  organizer: { "@type": "CollegeOrUniversity", name: "كلية الإمارات للعلوم والتقنية" },
};
---

<Base lang={lang} title={e.title} path={`events/${e.slug}/`} jsonLd={jsonLd} image={e.cover_url}>
  <PageHead
    lang={lang}
    title={e.title}
    lead={`${when}${e.location ? ` · ${e.location}` : ""}`}
    crumbs={[[lang === "ar" ? "الفعاليات" : "Events", "events/"]]}
  >
    {ended && (
      <p class="mt-4 inline-block rounded-full bg-surface-alt px-3 py-1 text-xs font-semibold text-text-muted">
        {lang === "ar" ? "انتهت هذه الفعالية" : "This event has ended"}
      </p>
    )}
    {!ended && e.registration_url && (
      <a
        href={e.registration_url}
        class="mt-5 inline-flex rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-accent-hover"
      >
        {t(lang, "register")}
      </a>
    )}
  </PageHead>
  <WithAside>
    <article class="max-w-3xl">
      {e.cover_url && <img src={e.cover_url} alt="" class="mb-8 w-full rounded-2xl" />}
      <div class="space-y-4 text-base leading-8" set:html={e.description} />
    </article>
    <Fragment slot="aside">
      <dl class="space-y-3 rounded-2xl bg-bg-subtle p-4 text-sm">
        <div>
          <dt class="text-text-muted">{L("الموعد", "When")}</dt>
          <dd class="font-semibold">{when}</dd>
        </div>
        {e.location && (
          <div>
            <dt class="text-text-muted">{L("المكان", "Where")}</dt>
            <dd class="font-semibold">{e.location}</dd>
          </div>
        )}
        <div>
          <dt class="text-text-muted">{L("الحالة", "Status")}</dt>
          <dd class="font-semibold">{ended ? L("انتهت", "Ended") : L("قادمة", "Upcoming")}</dd>
        </div>
      </dl>
      <SideLinks
        lang={lang}
        title={L("فعاليات قادمة أخرى", "Other upcoming events")}
        links={others}
      />
      <SideLinks lang={lang} title={L("ذو صلة", "Related")} links={more} />
    </Fragment>
  </WithAside>
</Base>
