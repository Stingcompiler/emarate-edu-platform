---
import EventRow from "../../../components/EventRow.astro";
import PageHead from "../../../components/PageHead.astro";
import SideLinks from "../../../components/SideLinks.astro";
import WithAside from "../../../components/WithAside.astro";
import Base from "../../../layouts/Base.astro";
import { events, pastEvents } from "../../../lib/api";
import { type Lang, langPaths, N, num, word } from "../../../lib/i18n";
import { related } from "../../../lib/related";

// docs/07 §1 `/events`: upcoming first, then the archive (ended events keep their pages).
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = (a: string, e: string) => (lang === "ar" ? a : e);
const [upcoming, past] = await Promise.all([events(), pastEvents()]);
upcoming.sort((a, b) => a.starts_at.localeCompare(b.starts_at));
const more = await related(lang, ["calendar", "news", "announcements"]);
---

<Base lang={lang} title={L("الفعاليات", "Events")} path="events/">
  <PageHead
    lang={lang}
    title={L("الفعاليات", "Events")}
    crumbs={[[L("الفعاليات", "Events"), "events/"]]}
  />
  <WithAside>
    <section>
      <h2 class="font-display text-2xl font-bold">{L("القادمة", "Upcoming")}</h2>
      <ul class="mt-4 grid gap-3 xl:grid-cols-2 xl:[&>li:last-child:nth-child(odd)]:col-span-2">
        {upcoming.map((e) => (
          <EventRow lang={lang} event={e} />
        ))}
        {!upcoming.length && (
          <li class="text-sm text-text-muted">
            {L("لا فعاليات قادمة الآن.", "No upcoming events.")}
          </li>
        )}
      </ul>
    </section>
    {past.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-2xl font-bold">{L("فعاليات سابقة", "Past events")}</h2>
        <ul class="mt-4 grid gap-3 xl:grid-cols-2 xl:[&>li:last-child:nth-child(odd)]:col-span-2">
          {past.map((e) => (
            <EventRow lang={lang} event={e} />
          ))}
        </ul>
      </section>
    )}
    <Fragment slot="aside">
      <div class="rounded-2xl bg-bg-subtle p-4">
        <p class="font-display text-3xl font-bold text-primary">{num(lang, upcoming.length)}</p>
        <p class="text-sm text-text-muted">{word(lang, upcoming.length, N.upcomingEvent)}</p>
      </div>
      <SideLinks lang={lang} title={L("ذو صلة", "Related")} links={more} />
    </Fragment>
  </WithAside>
</Base>
