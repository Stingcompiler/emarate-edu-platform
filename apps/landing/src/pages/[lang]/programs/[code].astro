---
import Faq from "../../../components/Faq.astro";
import PageHead from "../../../components/PageHead.astro";
import Base from "../../../layouts/Base.astro";
import { PORTAL, type ProgramDetail, get, programs, site } from "../../../lib/api";
import {
  arrow,
  count,
  degree,
  faqLd,
  fmtDate,
  href,
  type Lang,
  LANGS,
  money,
  N,
  num,
  pick,
  t,
  years,
} from "../../../lib/i18n";

export async function getStaticPaths() {
  const all = await programs();
  const details = await Promise.all(
    all.map((p) => get<ProgramDetail | null>(`programs/${p.code}`, null)),
  );
  return LANGS.flatMap((lang) =>
    details
      .filter((d): d is ProgramDetail => !!d)
      .map((d) => ({ params: { lang, code: d.code }, props: { program: d } })),
  );
}
const lang = Astro.params.lang as Lang;
const { program: p } = Astro.props as { program: ProgramDetail };
const s = await site();
const name = pick(lang, p.name_ar, p.name_en);
const description = pick(lang, p.description_ar, p.description_en);
const open = !!p.intake?.accepting;
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const dept = pick(lang, p.department_name, p.department_name_en);
const kind = degree(lang, p.degree, p.degree_label);
const closes = open ? fmtDate(lang, p.intake!.closes_at) : "";
const outcomes = (lang === "en" && p.outcomes_en?.length ? p.outcomes_en : p.outcomes_ar) ?? [];
const careers = (lang === "en" && p.careers_en?.length ? p.careers_en : p.careers_ar) ?? [];
const fees = [
  ...(p.fee_sdg ? [money(lang, p.fee_sdg, "SDG")] : []),
  ...(p.fee_usd
    ? [`${money(lang, p.fee_usd, "USD")} ${L("للوافدين", "for international students")}`]
    : []),
];
// «Ask on WhatsApp» opens a chat that already names the programme.
const whatsapp = s.whatsapp_e164
  ? `https://wa.me/${s.whatsapp_e164.replace(/\D/g, "")}?text=${encodeURIComponent(
      L(`السلام عليكم، أستفسر عن برنامج ${p.name_ar}.`, `Hello, I have a question about ${name}.`),
    )}`
  : null;
// Search results need a description of their own even before the department writes one:
// built only from the programme's data, never invented.
const summary =
  description ||
  L(
    `${name} — ${name.includes(kind) ? "" : `${kind}، `}${years(lang, p.duration_terms)}، قسم ${dept}.${open ? ` التقديم مفتوح حتى ${closes}.` : ""}`,
    `${name} — ${name.includes(kind) ? "" : `${kind}, `}${years(lang, p.duration_terms)}, ${dept}.${open ? ` Applications open until ${closes}.` : ""}`,
  );
// Questions applicants ask, answered from the programme's own data (docs/07: FAQ + FAQPage).
const faq: [string, string][] = [
  [
    L("ما مدة الدراسة؟", "How long is the programme?"),
    L(
      `${years(lang, p.duration_terms)} في ${num(lang, p.duration_terms)} فصول دراسية${p.credit_hours ? ` (${count(lang, p.credit_hours, N.hour)} معتمدة)` : ""}، ودرجته ${kind}.`,
      `${years(lang, p.duration_terms)} over ${p.duration_terms} terms${p.credit_hours ? ` (${p.credit_hours} credit hours)` : ""}, awarding a ${kind}.`,
    ),
  ],
  ...(fees.length
    ? ([
        [
          L("كم الرسوم الدراسية؟", "What are the fees?"),
          L(
            `الرسوم السنوية ${fees.join("، و")}. تفاصيل التقسيط والمنح في صفحة «الرسوم والمنح».`,
            `The yearly fee is ${fees.join(", or ")}. Instalments and scholarships are on the fees page.`,
          ),
        ],
      ] as [string, string][])
    : []),
  ...(p.requirements_ar
    ? ([[L("ما شروط القبول؟", "What are the requirements?"), p.requirements_ar]] as [
        string,
        string,
      ][])
    : []),
  ...(p.required_documents.length
    ? ([
        [
          L("ما المستندات المطلوبة؟", "Which documents do I need?"),
          p.required_documents
            .map((d) => `${d.label}${d.required ? "" : L(" (اختياري)", " (optional)")}`)
            .join(L("، ", ", ")),
        ],
      ] as [string, string][])
    : []),
  [
    L("متى يُغلق التقديم؟", "When do applications close?"),
    open
      ? L(
          `التقديم مفتوح حتى ${closes}${p.intake!.seats_left !== null ? `، والمقاعد المتبقية ${num(lang, p.intake!.seats_left)}` : ""}.`,
          `Applications are open until ${closes}${p.intake!.seats_left !== null ? `, with ${p.intake!.seats_left} seats left` : ""}.`,
        )
      : L(
          "التقديم مغلق حاليًا لهذا البرنامج. تُعلن الدورة القادمة في صفحة القبول.",
          "Applications are closed for now; the next cycle is announced on the admissions page.",
        ),
  ],
  [
    L("كيف أقدّم وأتابع طلبي؟", "How do I apply and follow up?"),
    L(
      "إلكترونيًا بالكامل من «قدّم لهذا البرنامج»: تتحقق من بريدك، تكمل النموذج وترفع المستندات، ثم تتابع طلبك برقمه المرجعي من «تابع طلبك» — بلا حساب أو زيارة.",
      "Entirely online from «Apply to this programme»: verify your email, fill in the form and upload the documents, then follow your application with its reference number — no account or visit.",
    ),
  ],
];
// Opens the application with this programme listed first (portal /apply?program=).
const applyUrl = `${PORTAL}/apply?program=${encodeURIComponent(p.code)}`;
const programLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  name: p.name_ar,
  alternateName: p.name_en || undefined,
  description: p.description_ar || undefined,
  educationalCredentialAwarded: p.degree_label,
  timeToComplete: `P${p.duration_terms / 2}Y`,
  provider: {
    "@type": "CollegeOrUniversity",
    name: s.name_ar,
    url: Astro.site?.toString(),
  },
  ...(p.credit_hours ? { numberOfCredits: p.credit_hours } : {}),
  ...(p.fee_sdg || p.fee_usd
    ? {
        offers: [
          ...(p.fee_sdg ? [{ price: p.fee_sdg, priceCurrency: "SDG" }] : []),
          ...(p.fee_usd ? [{ price: p.fee_usd, priceCurrency: "USD" }] : []),
        ].map((o) => ({ "@type": "Offer", category: "Tuition", ...o })),
      }
    : {}),
  ...(open ? { applicationDeadline: p.intake!.closes_at.slice(0, 10) } : {}),
};
const jsonLd = [programLd, faqLd(faq)];
---

<Base
  lang={lang}
  title={name}
  path={`programs/${p.code}/`}
  description={summary}
  jsonLd={jsonLd}
  bottomBar={open}
>
  <PageHead
    lang={lang}
    title={name}
    lead={description}
    feature
    crumbs={[
      [t(lang, "programs"), "programs/"],
      [pick(lang, p.department_name, p.department_name_en), `departments/${p.department_code}/`],
    ]}
  >
    {open && (
      <div class="mt-5 flex flex-wrap items-center gap-3 rounded-2xl bg-success-soft p-4 text-sm text-success-strong">
        <span class="font-semibold">
          {lang === "ar"
            ? `التقديم مفتوح حتى ${fmtDate(lang, p.intake!.closes_at)}`
            : `Applications open until ${fmtDate(lang, p.intake!.closes_at)}`}
          {p.intake!.seats_left !== null && (
            <span class="whitespace-nowrap">
              {lang === "ar"
                ? ` · المقاعد المتبقية: ${num(lang, p.intake!.seats_left)}`
                : ` · ${p.intake!.seats_left} seats left`}
            </span>
          )}
        </span>
        <a
          href={applyUrl}
          data-no-print
          class="ms-auto rounded-lg bg-accent px-4 py-2 font-semibold text-on-primary hover:bg-accent-hover"
        >
          {t(lang, "apply")}
        </a>
      </div>
    )}
  </PageHead>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-start lg:px-8">
    {/* The applicant's essentials: first on the phone, a sticky side card on large screens. */}
    <aside class="lg:sticky lg:top-24 lg:col-start-2 lg:row-start-1 print:static">
      <section
        aria-labelledby="facts"
        class="rounded-2xl border border-border-soft bg-surface p-4 shadow-sm lg:p-5"
      >
        <h2 id="facts" class="text-lg font-bold">
          {L("أساسيات المتقدم", "At a glance")}
        </h2>
        <div
          class:list={[
            "mt-3 grid gap-2 text-center",
            p.credit_hours ? "grid-cols-3" : "grid-cols-2",
          ]}
        >
          {(
            [
              [p.duration_terms, t(lang, "terms")],
              ...(p.credit_hours ? [[p.credit_hours, t(lang, "hours")]] : []),
              [p.levels_count, t(lang, "levels")],
            ] as [number, string][]
          ).map(([n, l]) => (
            <div class="rounded-xl bg-bg-subtle p-3">
              <p class="font-display text-2xl font-bold text-primary">{num(lang, Number(n))}</p>
              <p class="text-xs text-text-muted">{l}</p>
            </div>
          ))}
        </div>
        <dl class="mt-4 divide-y divide-border-soft text-sm">
          <div class="flex justify-between gap-3 py-2">
            <dt class="text-text-muted">{L("الدرجة", "Degree")}</dt>
            <dd class="text-end font-semibold">{kind}</dd>
          </div>
          <div class="flex justify-between gap-3 py-2">
            <dt class="text-text-muted">{L("المدة", "Duration")}</dt>
            <dd class="text-end font-semibold">{years(lang, p.duration_terms)}</dd>
          </div>
          <div class="flex justify-between gap-3 py-2">
            <dt class="text-text-muted">{L("القسم", "Department")}</dt>
            <dd class="text-end font-semibold">
              <a
                href={href(lang, `departments/${p.department_code}/`)}
                class="tap-44 text-primary hover:underline"
              >
                {dept}
              </a>
            </dd>
          </div>
          {fees.length > 0 && (
            <div class="flex justify-between gap-3 py-2">
              <dt class="text-text-muted">{L("الرسوم السنوية", "Yearly fee")}</dt>
              <dd class="text-end font-semibold">
                {fees.map((f) => (
                  <span class="block">
                    <bdi>{f}</bdi>
                  </span>
                ))}
              </dd>
            </div>
          )}
          <div class="flex justify-between gap-3 py-2">
            <dt class="text-text-muted">{L("التقديم", "Applications")}</dt>
            <dd
              class:list={[
                "text-end font-semibold",
                open ? "text-success-strong" : "text-text-muted",
              ]}
            >
              {open
                ? L(`مفتوح حتى ${closes}`, `Open until ${closes}`)
                : L("مغلق حاليًا", "Closed for now")}
            </dd>
          </div>
        </dl>
        <div class="mt-4 grid gap-2" data-no-print>
          {open ? (
            <a
              href={applyUrl}
              class="flex min-h-12 items-center justify-center rounded-xl bg-accent px-4 font-semibold text-on-primary hover:bg-accent-hover"
            >
              {L("قدّم لهذا البرنامج", "Apply to this programme")}
            </a>
          ) : (
            <a
              href={href(lang, "admissions/")}
              class="flex min-h-12 items-center justify-center rounded-xl bg-primary px-4 font-semibold text-on-primary hover:bg-primary-hover"
            >
              {L("مواعيد القبول", "Admission dates")}
            </a>
          )}
          {whatsapp ? (
            <a
              href={whatsapp}
              rel="noopener"
              target="_blank"
              class="flex min-h-11 items-center justify-center gap-2 rounded-xl border border-border bg-surface px-4 text-sm font-semibold text-text hover:bg-surface-alt"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                class="text-success"
              >
                <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5A8 8 0 1 1 21 12z" />
              </svg>
              {L("اسأل عبر واتساب", "Ask on WhatsApp")}
            </a>
          ) : (
            <a
              href={href(lang, "contact/")}
              class="flex min-h-11 items-center justify-center rounded-xl border border-border bg-surface px-4 text-sm font-semibold text-text hover:bg-surface-alt"
            >
              {L("لديك سؤال؟ تواصل معنا", "Questions? Contact us")}
            </a>
          )}
          <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-sm">
            <a
              href={href(lang, "admissions/fees/")}
              class="tap-44 font-semibold text-primary hover:underline"
            >
              {L("الرسوم والمنح", "Fees and scholarships")} {arrow(lang)}
            </a>
            <button
              type="button"
              data-print
              class="tap-44 font-semibold text-text-muted hover:text-text"
            >
              {L("اطبع صفحة البرنامج", "Print this programme")}
            </button>
          </div>
        </div>
      </section>
      <a
        href={`${PORTAL}/track`}
        data-no-print
        class="mt-3 block rounded-2xl bg-bg-subtle p-4 text-sm font-semibold text-primary"
      >
        {t(lang, "track")} {arrow(lang)}
      </a>
    </aside>
    <div class="lg:col-start-1 lg:row-start-1">
      {outcomes.length > 0 && (
        <section aria-labelledby="outcomes">
          <h2 id="outcomes" class="font-display text-2xl font-bold">
            {L("ماذا ستتعلم", "What you will learn")}
          </h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2 sm:[&>li:last-child:nth-child(odd)]:col-span-2">
            {outcomes.map((o) => (
              <li class="flex gap-2 rounded-xl bg-bg-subtle p-3 text-sm leading-6">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-success"
                >
                  <path d="M5 12l5 5L20 7" />
                </svg>
                {o}
              </li>
            ))}
          </ul>
        </section>
      )}
      {careers.length > 0 && (
        <section aria-labelledby="careers" class="mt-10 first:mt-0">
          <h2 id="careers" class="font-display text-2xl font-bold">
            {L("أين يعمل الخريجون", "Where graduates work")}
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {careers.map((c) => (
              <li class="rounded-full border border-border-soft bg-surface px-3 py-1.5 text-sm">
                {c}
              </li>
            ))}
          </ul>
        </section>
      )}
      {/* Requirements and documents come before the plan: what an applicant needs first (W7). */}
      {(p.requirements_ar || p.required_documents.length > 0) && (
        <section aria-labelledby="admission" class="mt-10 first:mt-0">
          <h2 id="admission" class="font-display text-2xl font-bold">
            {L("القبول", "Admission")}
          </h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 sm:[&>div:last-child:nth-child(odd)]:col-span-2">
            {p.requirements_ar && (
              <div class="rounded-2xl border border-border-soft bg-surface p-4 text-sm leading-6">
                <h3 class="mb-2 font-bold">{L("شروط القبول", "Requirements")}</h3>
                {p.requirements_ar}
              </div>
            )}
            {p.required_documents.length > 0 && (
              <div class="rounded-2xl border border-border-soft bg-surface p-4">
                <h3 class="font-bold">{t(lang, "documents")}</h3>
                <ol class="mt-3 space-y-2 text-sm">
                  {p.required_documents.map((doc, i) => (
                    <li class="flex gap-2">
                      <span class="grid size-6 shrink-0 place-items-center rounded-full bg-primary-soft text-xs font-bold text-primary-700">
                        {num(lang, i + 1)}
                      </span>
                      {doc.label}
                      {!doc.required && (
                        <span class="text-text-muted">({L("اختياري", "optional")})</span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </section>
      )}
      <section aria-labelledby="plan" class="mt-10 first:mt-0">
        <h2 id="plan" class="font-display text-2xl font-bold">
          {t(lang, "plan")}
        </h2>
        <ol class="mt-4 space-y-3">
          {p.plan.map((level) => {
            const hours = level.courses.reduce((sum, c) => sum + (c.credit_hours || 0), 0);
            return (
              <li class="break-inside-avoid rounded-2xl border border-border-soft bg-surface p-4">
                <p class="flex items-baseline justify-between gap-3 text-sm font-bold text-primary">
                  <span>
                    {t(lang, "level")} {num(lang, level.level)}
                  </span>
                  {hours > 0 && (
                    <span class="text-xs font-semibold text-text-muted">
                      {count(lang, hours, N.hour)}
                    </span>
                  )}
                </p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {level.courses.map((c) => (
                    <li class="rounded-lg bg-surface-alt px-3 py-1.5 text-sm">
                      {pick(lang, c.name_ar, c.name_en)}
                      {c.credit_hours > 0 && (
                        <span class="ms-1 text-xs text-text-muted">
                          · {num(lang, c.credit_hours)}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
          {!p.plan.length && (
            <li class="text-sm text-text-muted">{L("تُنشر الخطة قريبًا.", "Plan coming soon.")}</li>
          )}
        </ol>
        {p.plan.length > 0 && (
          <p class="mt-2 text-xs text-text-muted">
            {L(
              "الرقم بجانب المادة ساعاتها المعتمدة.",
              "The number beside a course is its credit hours.",
            )}
          </p>
        )}
      </section>
      <div class="mt-10" data-no-print>
        <Faq title={L("أسئلة شائعة", "Common questions")} items={faq} />
      </div>
    </div>
  </div>
  <script>
    document
      .querySelectorAll("[data-print]")
      .forEach((b) => b.addEventListener("click", () => window.print()));
  </script>
  {open && (
    <>
      {/* Phone: the page is long, so the way to apply stays in reach (board VisitorProgram). */}
      <div
        data-no-print
        data-apply-bar
        class="fixed inset-x-0 bottom-0 z-20 flex gap-2 border-t border-border-soft bg-surface/95 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur lg:hidden"
      >
        <a
          href={applyUrl}
          class="flex min-h-12 flex-1 items-center justify-center rounded-xl bg-accent px-4 font-semibold text-on-primary hover:bg-accent-hover"
        >
          {lang === "ar" ? "قدّم لهذا البرنامج" : "Apply to this programme"}
        </a>
        <a
          href={whatsapp ?? href(lang, "contact/")}
          {...(whatsapp ? { rel: "noopener", target: "_blank" } : {})}
          aria-label={
            whatsapp ? L("اسأل عبر واتساب", "Ask on WhatsApp") : L("تواصل معنا", "Contact us")
          }
          class="grid size-12 shrink-0 place-items-center rounded-xl border border-border bg-surface text-primary hover:bg-surface-alt"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5A8 8 0 1 1 21 12z" />
          </svg>
        </a>
      </div>
    </>
  )}
</Base>
