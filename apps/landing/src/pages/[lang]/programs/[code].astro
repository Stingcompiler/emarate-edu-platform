---
import Faq from "../../../components/Faq.astro";
import PageHead from "../../../components/PageHead.astro";
import Base from "../../../layouts/Base.astro";
import { PORTAL, type ProgramDetail, get, programs } from "../../../lib/api";
import {
  arrow,
  degree,
  faqLd,
  fmtDate,
  href,
  type Lang,
  LANGS,
  num,
  pick,
  t,
  years,
} from "../../../lib/i18n";

export async function getStaticPaths() {
  const all = await programs();
  const details = await Promise.all(
    all.map((p) => get<ProgramDetail | null>(`programs/${p.code}`, null)),
  );
  return LANGS.flatMap((lang) =>
    details
      .filter((d): d is ProgramDetail => !!d)
      .map((d) => ({ params: { lang, code: d.code }, props: { program: d } })),
  );
}
const lang = Astro.params.lang as Lang;
const { program: p } = Astro.props as { program: ProgramDetail };
const name = pick(lang, p.name_ar, p.name_en);
const description = pick(lang, p.description_ar, p.description_en);
const open = !!p.intake?.accepting;
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const dept = pick(lang, p.department_name, p.department_name_en);
const kind = degree(lang, p.degree, p.degree_label);
const closes = open ? fmtDate(lang, p.intake!.closes_at) : "";
// Search results need a description of their own even before the department writes one:
// built only from the programme's data, never invented.
const summary =
  description ||
  L(
    `${name} — ${name.includes(kind) ? "" : `${kind}، `}${years(lang, p.duration_terms)}، قسم ${dept}.${open ? ` التقديم مفتوح حتى ${closes}.` : ""}`,
    `${name} — ${name.includes(kind) ? "" : `${kind}, `}${years(lang, p.duration_terms)}, ${dept}.${open ? ` Applications open until ${closes}.` : ""}`,
  );
// Questions applicants ask, answered from the programme's own data (docs/07: FAQ + FAQPage).
const faq: [string, string][] = [
  [
    L("ما مدة الدراسة؟", "How long is the programme?"),
    L(
      `${years(lang, p.duration_terms)} في ${num(lang, p.duration_terms)} فصول دراسية، ودرجته ${kind}.`,
      `${years(lang, p.duration_terms)} over ${p.duration_terms} terms, awarding a ${kind}.`,
    ),
  ],
  ...(p.requirements_ar
    ? ([[L("ما شروط القبول؟", "What are the requirements?"), p.requirements_ar]] as [
        string,
        string,
      ][])
    : []),
  ...(p.required_documents.length
    ? ([
        [
          L("ما المستندات المطلوبة؟", "Which documents do I need?"),
          p.required_documents
            .map((d) => `${d.label}${d.required ? "" : L(" (اختياري)", " (optional)")}`)
            .join(L("، ", ", ")),
        ],
      ] as [string, string][])
    : []),
  [
    L("متى يُغلق التقديم؟", "When do applications close?"),
    open
      ? L(
          `التقديم مفتوح حتى ${closes}${p.intake!.seats_left !== null ? `، والمقاعد المتبقية ${num(lang, p.intake!.seats_left)}` : ""}.`,
          `Applications are open until ${closes}${p.intake!.seats_left !== null ? `, with ${p.intake!.seats_left} seats left` : ""}.`,
        )
      : L(
          "التقديم مغلق حاليًا لهذا البرنامج. تُعلن الدورة القادمة في صفحة القبول.",
          "Applications are closed for now; the next cycle is announced on the admissions page.",
        ),
  ],
  [
    L("كيف أقدّم وأتابع طلبي؟", "How do I apply and follow up?"),
    L(
      "إلكترونيًا بالكامل من «قدّم لهذا البرنامج»: تتحقق من بريدك، تكمل النموذج وترفع المستندات، ثم تتابع طلبك برقمه المرجعي من «تابع طلبك» — بلا حساب أو زيارة.",
      "Entirely online from «Apply to this programme»: verify your email, fill in the form and upload the documents, then follow your application with its reference number — no account or visit.",
    ),
  ],
];
// Opens the application with this programme listed first (portal /apply?program=).
const applyUrl = `${PORTAL}/apply?program=${encodeURIComponent(p.code)}`;
const programLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  name: p.name_ar,
  alternateName: p.name_en || undefined,
  description: p.description_ar || undefined,
  educationalCredentialAwarded: p.degree_label,
  timeToComplete: `P${p.duration_terms / 2}Y`,
  provider: {
    "@type": "CollegeOrUniversity",
    name: "كلية الإمارات للعلوم والتقنية",
    url: Astro.site?.toString(),
  },
  ...(open ? { applicationDeadline: p.intake!.closes_at.slice(0, 10) } : {}),
};
const jsonLd = [programLd, faqLd(faq)];
---

<Base
  lang={lang}
  title={name}
  path={`programs/${p.code}/`}
  description={summary}
  jsonLd={jsonLd}
  bottomBar={open}
>
  <PageHead
    lang={lang}
    title={name}
    lead={description}
    crumbs={[
      [t(lang, "programs"), "programs/"],
      [pick(lang, p.department_name, p.department_name_en), `departments/${p.department_code}/`],
    ]}
  >
    {open && (
      <div class="mt-5 flex flex-wrap items-center gap-3 rounded-2xl bg-success-soft p-4 text-sm text-success-strong">
        <span class="font-semibold">
          {lang === "ar"
            ? `التقديم مفتوح حتى ${fmtDate(lang, p.intake!.closes_at)}`
            : `Applications open until ${fmtDate(lang, p.intake!.closes_at)}`}
          {p.intake!.seats_left !== null && (
            <span class="whitespace-nowrap">
              {lang === "ar"
                ? ` · المقاعد المتبقية: ${num(lang, p.intake!.seats_left)}`
                : ` · ${p.intake!.seats_left} seats left`}
            </span>
          )}
        </span>
        <a
          href={applyUrl}
          class="ms-auto rounded-lg bg-primary px-4 py-2 font-semibold text-white hover:bg-primary-hover"
        >
          {t(lang, "apply")}
        </a>
      </div>
    )}
  </PageHead>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[2fr_1fr] lg:px-8">
    <div>
      <div class="grid grid-cols-3 gap-2 text-center">
        {[
          [p.duration_terms, t(lang, "terms")],
          [p.credit_hours, t(lang, "hours")],
          [p.levels_count, t(lang, "levels")],
        ].map(([n, l]) => (
          <div class="rounded-2xl bg-bg-subtle p-4">
            <p class="font-display text-2xl font-bold text-primary">{num(lang, Number(n))}</p>
            <p class="text-xs text-text-muted">{l}</p>
          </div>
        ))}
      </div>
      <h2 class="mt-10 font-display text-xl font-bold">{t(lang, "plan")}</h2>
      <ol class="mt-4 space-y-3">
        {p.plan.map((level) => (
          <li class="rounded-2xl border border-border-soft bg-surface p-4">
            <p class="text-sm font-bold text-primary">
              {t(lang, "level")} {num(lang, level.level)}
            </p>
            <ul class="mt-2 flex flex-wrap gap-2">
              {level.courses.map((c) => (
                <li class="rounded-lg bg-surface-alt px-3 py-1.5 text-sm">
                  {pick(lang, c.name_ar, c.name_en)}
                </li>
              ))}
            </ul>
          </li>
        ))}
        {!p.plan.length && (
          <li class="text-sm text-text-muted">
            {lang === "ar" ? "تُنشر الخطة قريبًا." : "Plan coming soon."}
          </li>
        )}
      </ol>
      <div class="mt-10">
        <Faq title={L("أسئلة شائعة", "Common questions")} items={faq} />
      </div>
    </div>
    <aside class="space-y-4">
      {p.requirements_ar && (
        <div class="rounded-2xl border border-border-soft bg-surface p-4 text-sm leading-6">
          <h2 class="mb-2 font-bold">{lang === "ar" ? "شروط القبول" : "Requirements"}</h2>
          {p.requirements_ar}
        </div>
      )}
      {p.required_documents.length > 0 && (
        <div class="rounded-2xl border border-border-soft bg-surface p-4">
          <h2 class="font-bold">{t(lang, "documents")}</h2>
          <ol class="mt-3 space-y-2 text-sm">
            {p.required_documents.map((doc, i) => (
              <li class="flex gap-2">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-primary-soft text-xs font-bold text-primary-700">
                  {num(lang, i + 1)}
                </span>
                {doc.label}
                {!doc.required && (
                  <span class="text-text-muted">({lang === "ar" ? "اختياري" : "optional"})</span>
                )}
              </li>
            ))}
          </ol>
        </div>
      )}
      <a
        href={`${PORTAL}/track`}
        class="block rounded-2xl bg-bg-subtle p-4 text-sm font-semibold text-primary"
      >
        {t(lang, "track")} {arrow(lang)}
      </a>
      <a
        href={href(lang, "contact/")}
        class="block rounded-2xl bg-bg-subtle p-4 text-sm font-semibold text-primary"
      >
        {lang === "ar" ? "لديك سؤال؟ تواصل معنا" : "Questions? Contact us"} {arrow(lang)}
      </a>
    </aside>
  </div>
  {open && (
    <>
      {/* Phone: the page is long, so the way to apply stays in reach (board VisitorProgram). */}
      <div class="fixed inset-x-0 bottom-0 z-20 flex gap-2 border-t border-border-soft bg-surface/95 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur lg:hidden">
        <a
          href={applyUrl}
          class="flex min-h-12 flex-1 items-center justify-center rounded-xl bg-accent px-4 font-semibold text-white hover:bg-accent-hover"
        >
          {lang === "ar" ? "قدّم لهذا البرنامج" : "Apply to this programme"}
        </a>
        <a
          href={href(lang, "contact/")}
          aria-label={lang === "ar" ? "تواصل معنا" : "Contact us"}
          class="grid size-12 shrink-0 place-items-center rounded-xl border border-border bg-surface text-primary hover:bg-surface-alt"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5A8 8 0 1 1 21 12z" />
          </svg>
        </a>
      </div>
    </>
  )}
</Base>
