---
import PageHead from "../../../components/PageHead.astro";
import ProgramRow from "../../../components/ProgramRow.astro";
import Base from "../../../layouts/Base.astro";
import { pageDescription } from "../../../lib/descriptions";
import { programs } from "../../../lib/api";
import { type Lang, degree, fmtDate, langPaths, num, pick, t, count, N } from "../../../lib/i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const all = await programs();
const open = all.filter((p) => p.intake?.accepting);
const closes = open.map((p) => p.intake!.closes_at).sort()[0];
const groups = [...new Set(all.map((p) => p.department_code))].map((code) => {
  const items = all.filter((p) => p.department_code === code);
  return {
    code,
    name: pick(lang, items[0]!.department_name, items[0]!.department_name_en),
    items,
  };
});
const degrees = [...new Map(all.map((p) => [p.degree, p.degree_label])).entries()];
const lead =
  lang === "ar"
    ? `${count(lang, all.length, N.program)} في ${count(lang, groups.length, N.department)}${open.length ? ` · ${num(lang, open.length)} مفتوحة للتقديم حتى ${fmtDate(lang, closes!)}` : ""}`
    : `${count(lang, all.length, N.program)} in ${count(lang, groups.length, N.department)}${open.length ? ` · ${open.length} open until ${fmtDate(lang, closes!)}` : ""}`;
---

<Base
  lang={lang}
  title={t(lang, "programs")}
  path="programs/"
  description={pageDescription(lang, "programs")}
>
  <PageHead
    lang={lang}
    title={t(lang, "programs")}
    lead={lead}
    crumbs={[[t(lang, "programs"), "programs/"]]}
  >
    {/* The finder (W14). UX review 2026-11-04: on a phone the chips filled the first screen
        before any programme. The search stays; degree, «open» and department sit behind
        «تصفية» there (always shown from lg); the department is a list, not twenty chips; the
        count follows every change, with a way back to all of them. */}
    <div class="mt-5 space-y-3" data-finder data-lang={lang}>
      <div class="flex max-w-xl gap-2">
        <label class="block min-w-0 flex-1">
          <span class="sr-only">{lang === "ar" ? "ابحث عن برنامج" : "Search programmes"}</span>
          <input
            type="search"
            data-search-input
            placeholder={lang === "ar" ? "ابحث باسم البرنامج أو رمزه" : "Search by name or code"}
            class="block min-h-11 w-full rounded-xl border border-border bg-surface px-4 text-sm"
          />
        </label>
        <button
          type="button"
          data-filters-toggle
          aria-expanded="false"
          aria-controls="program-filters"
          hidden
          class="min-h-11 shrink-0 rounded-xl border border-border bg-surface px-4 text-sm font-semibold lg:hidden"
        >
          {lang === "ar" ? "تصفية" : "Filter"}
          <span data-active-count class="ms-1 text-primary"></span>
        </button>
      </div>
      <div id="program-filters" data-filters class="space-y-3">
        <div
          class="flex flex-wrap gap-2"
          role="group"
          aria-label={lang === "ar" ? "الدرجة" : "Degree"}
        >
          <button type="button" data-facet="all" aria-pressed="true" class="chip">
            {t(lang, "all")}
          </button>
          {degrees.map(([key, label]) => (
            <button type="button" data-facet={`degree:${key}`} aria-pressed="false" class="chip">
              {degree(lang, key, label)}
            </button>
          ))}
          {open.length > 0 && (
            <button type="button" data-facet="open" aria-pressed="false" class="chip">
              {lang === "ar" ? "التقديم مفتوح" : "Open now"}
            </button>
          )}
        </div>
        {groups.length > 1 && (
          <label class="block max-w-xs text-sm font-semibold">
            {lang === "ar" ? "القسم" : "Department"}
            <select
              data-dept-select
              class="mt-1 block min-h-11 w-full rounded-xl border border-border bg-surface px-3 text-sm font-normal"
            >
              <option value="all">{lang === "ar" ? "كل الأقسام" : "All departments"}</option>
              {groups.map((g) => (
                <option value={g.code}>{g.name}</option>
              ))}
            </select>
          </label>
        )}
      </div>
      <p class="flex flex-wrap items-center gap-x-3 text-sm">
        <span data-result-count role="status" class="font-semibold">
          {count(lang, all.length, N.program)}
        </span>
        <button
          type="button"
          data-clear
          hidden
          class="tap-44 font-semibold text-primary underline underline-offset-4"
        >
          {lang === "ar" ? "مسح التصفية" : "Clear filters"}
        </button>
      </p>
      <div data-none hidden class="rounded-2xl border border-border-soft bg-surface p-5 text-sm">
        <p class="font-semibold">
          {lang === "ar" ? "لا برامج تطابق بحثك." : "No programme matches."}
        </p>
        <p class="mt-1 text-text-muted">
          {lang === "ar"
            ? "جرّب كلمة أقصر أو جزءًا من اسم البرنامج، أو اعرض كل البرامج."
            : "Try a shorter word or part of the name, or show every programme."}
        </p>
        <button
          type="button"
          data-clear
          class="mt-3 min-h-11 rounded-lg bg-text px-4 font-semibold text-bg"
        >
          {lang === "ar" ? "عرض كل البرامج" : "Show all programmes"}
        </button>
      </div>
    </div>
  </PageHead>
  <div class="mx-auto max-w-6xl space-y-10 px-4 py-10 lg:px-8">
    {groups.map((g) => (
      <section data-group>
        <h2 class="font-display text-2xl font-bold">
          {g.name}{" "}
          <span class="text-sm font-normal text-text-muted">· {num(lang, g.items.length)}</span>
        </h2>
        <ul class="mt-4 grid divide-y divide-border-soft overflow-hidden rounded-2xl border border-border-soft bg-surface lg:grid-cols-2 lg:divide-y-0 lg:[&>li]:border-b lg:[&>li]:border-border-soft lg:[&>li:nth-child(odd)]:border-e lg:[&>li:last-child:nth-child(odd)]:col-span-2 lg:[&>li:last-child:nth-child(odd)]:border-e-0">
          {g.items.map((p) => (
            <ProgramRow lang={lang} program={p} />
          ))}
        </ul>
      </section>
    ))}
    {!all.length && (
      <p class="text-text-muted">{lang === "ar" ? "لا برامج منشورة بعد." : "No programmes yet."}</p>
    )}
  </div>
</Base>

<style>
  .chip {
    border-radius: 9999px;
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface);
    padding: 0.35rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .chip[aria-pressed="true"] {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>

<script>
  import { fold } from "../../../lib/fold";
  import { count, N, type Lang } from "../../../lib/i18n";

  // Progressive enhancement: without JS every programme and every filter stays visible.
  const finder = document.querySelector<HTMLElement>("[data-finder]")!;
  const lang = finder.dataset.lang as Lang;
  const state = { facet: "all", dept: "all", q: "" };
  const search = finder.querySelector<HTMLInputElement>("[data-search-input]")!;
  const select = finder.querySelector<HTMLSelectElement>("[data-dept-select]");
  const facets = finder.querySelectorAll<HTMLButtonElement>("[data-facet]");
  const toggle = finder.querySelector<HTMLButtonElement>("[data-filters-toggle]")!;
  const panel = finder.querySelector<HTMLElement>("[data-filters]")!;
  const narrow = window.matchMedia("(max-width: 1023px)");

  const apply = () => {
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-degree]").forEach((row) => {
      const show =
        (state.facet === "all" ||
          (state.facet === "open" && row.dataset.open === "1") ||
          state.facet === `degree:${row.dataset.degree}`) &&
        (state.dept === "all" || row.dataset.department === state.dept) &&
        (!state.q || row.dataset.search!.includes(state.q));
      row.hidden = !show;
      if (show) shown++;
    });
    document.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
      group.hidden = ![...group.querySelectorAll<HTMLElement>("[data-degree]")].some(
        (c) => !c.hidden,
      );
    });
    const active = (state.facet !== "all" ? 1 : 0) + (state.dept !== "all" ? 1 : 0);
    finder.querySelector("[data-result-count]")!.textContent = count(lang, shown, N.program);
    finder.querySelector<HTMLElement>("[data-none]")!.hidden = shown > 0;
    finder.querySelectorAll<HTMLElement>("[data-clear]")[0]!.hidden = !(active || state.q);
    finder.querySelector("[data-active-count]")!.textContent = active ? `(${active})` : "";
  };
  const setFacet = (value: string) => {
    state.facet = value;
    facets.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.facet === value)));
  };
  facets.forEach((button) =>
    button.addEventListener("click", () => {
      setFacet(button.dataset.facet!);
      apply();
    }),
  );
  select?.addEventListener("change", () => {
    state.dept = select.value;
    apply();
  });
  search.addEventListener("input", () => {
    state.q = fold(search.value);
    apply();
  });
  finder.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach((button) =>
    button.addEventListener("click", () => {
      setFacet("all");
      state.dept = "all";
      if (select) select.value = "all";
      state.q = "";
      search.value = "";
      apply();
      search.focus();
    }),
  );
  // Phones: the filters fold behind «تصفية» so the first programmes show on the first screen.
  const fold_ = () => {
    toggle.hidden = !narrow.matches;
    panel.hidden = narrow.matches && toggle.getAttribute("aria-expanded") !== "true";
  };
  toggle.addEventListener("click", () => {
    toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true"));
    fold_();
  });
  narrow.addEventListener("change", fold_);
  fold_();
  // «كل المفتوحة» on the home page lands here already narrowed to the open programmes.
  if (
    new URLSearchParams(location.search).get("open") === "1" &&
    finder.querySelector('[data-facet="open"]')
  ) {
    setFacet("open");
    apply();
  }
</script>
