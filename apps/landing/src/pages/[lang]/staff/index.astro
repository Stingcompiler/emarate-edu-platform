---
import PageHead from "../../../components/PageHead.astro";
import StaffCard from "../../../components/StaffCard.astro";
import Base from "../../../layouts/Base.astro";
import { site, staff, staffGroups } from "../../../lib/api";
import { type Lang, langPaths, pick, t } from "../../../lib/i18n";

// «الكوادر» (owner, 2026-10-30): every member who chose to appear, as cards. In groups since
// 2026-11-09 («هيئة الإدارة», «هيئة التدريس», any the site team adds); a member who teaches keeps
// their card and page. Without groups (an older API), the one list as before.
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const [s, members, all] = await Promise.all([site(), staff(), staffGroups()]);
// A group whose members were all sample rows (hidden in production) does not show empty.
const groups = all.filter((g) => g.members.length);
const pages = new Map(members.map((m) => [m.id, m]));
// The site manager's own line (site settings), else the built-in one.
const lead = (lang === "en" ? s.staff_intro_en : s.staff_intro_ar) || t(lang, "staffLead");
---

<Base lang={lang} title={t(lang, "staff")} path="staff/" description={lead}>
  <PageHead
    lang={lang}
    title={t(lang, "staff")}
    lead={lead}
    crumbs={[[t(lang, "staff"), "staff/"]]}
  />
  <div class="mx-auto max-w-6xl px-4 py-10 lg:px-8">
    {groups.length ? (
      groups.map((g) => (
        <section class="mb-10" aria-labelledby={`group-${g.id}`}>
          <h2 id={`group-${g.id}`} class="mb-4 font-display text-2xl font-bold">
            {pick(lang, g.name_ar, g.name_en)}
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.members.map((m, i) => (
              <li>
                <StaffCard
                  lang={lang}
                  member={(m.id && pages.get(m.id)) || m}
                  position={pick(lang, m.position_ar, m.position_en)}
                  index={i}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : members.length ? (
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((m, i) => (
          <li>
            <StaffCard lang={lang} member={m} index={i} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-text-muted">
        {lang === "ar"
          ? "لم يُنشر أعضاء هيئة التدريس هنا بعد."
          : "No faculty members are listed here yet."}
      </p>
    )}
  </div>
</Base>
