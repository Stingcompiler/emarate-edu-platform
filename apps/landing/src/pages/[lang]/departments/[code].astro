---
import ArabicOnly from "../../../components/ArabicOnly.astro";
import PageHead from "../../../components/PageHead.astro";
import ProgramRow from "../../../components/ProgramRow.astro";
import SideLinks from "../../../components/SideLinks.astro";
import WithAside from "../../../components/WithAside.astro";
import Base from "../../../layouts/Base.astro";
import { PORTAL, type Department, departments, site } from "../../../lib/api";
import {
  LANGS,
  type Lang,
  arrow,
  count,
  fmtDate,
  href,
  N,
  pick,
  t,
  num,
  word,
  isArabic,
} from "../../../lib/i18n";

export async function getStaticPaths() {
  const depts = await departments();
  return LANGS.flatMap((lang) =>
    depts.map((d) => ({ params: { lang, code: d.code }, props: { department: d, all: depts } })),
  );
}
const lang = Astro.params.lang as Lang;
const { department: d, all } = Astro.props as { department: Department; all: Department[] };
const s = await site();
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const name = pick(lang, d.name_ar, d.name_en);
const open = d.programs.filter((p) => p.intake?.accepting);
const closes = open.map((p) => p.intake!.closes_at).sort()[0];
// Searches need a description even before the department writes one — built from its data.
const summary =
  d.description ||
  L(
    `قسم ${name} في ${s.name_ar}: ${count(lang, d.programs.length, N.program)}.`,
    `${name} at ${s.name_en || s.name_ar}: ${count(lang, d.programs.length, N.program)}.`,
  );
// Members who chose to appear (their own consent, owner decision 2026-09-30), and the
// department's own public news.
const faculty = d.faculty ?? [];
const news = d.news ?? [];
const ROLE: Record<string, string> = {
  manager: L("رئيس القسم", "Head of department"),
  teacher: "",
  ta: L("معيد", "Teaching assistant"),
};
const initial = (name: string) =>
  (name.replace(/^(د|أ|م|Dr|Prof|Mr|Ms)\.?\s+/u, "").trim()[0] ?? "").toUpperCase();
const others = all
  .filter((o) => o.code !== d.code)
  .map((o) => ({
    label: pick(lang, o.name_ar, o.name_en),
    href: href(lang, `departments/${o.code}/`),
  }));
---

<Base lang={lang} title={name} path={`departments/${d.code}/`} description={summary}>
  <PageHead
    lang={lang}
    title={lang === "ar" ? `قسم ${name}` : name}
    lead={d.description}
    feature
    facts={[[num(lang, d.programs.length), word(lang, d.programs.length, N.program)]]}
    crumbs={[
      [t(lang, "departments"), "departments/"],
      [name, `departments/${d.code}/`],
    ]}
  >
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {d.manager && (
        <span>
          <b>{d.manager}</b> · <span class="text-text-muted">{t(lang, "manager")}</span>
        </span>
      )}
    </p>
  </PageHead>
  <WithAside>
    <div>
      {open.length > 0 && (
        <div class="mb-8 flex flex-wrap items-center gap-3 rounded-2xl bg-success-soft p-4 text-sm text-success-strong">
          <span class="font-semibold">
            {L(
              `${count(lang, open.length, N.program)} في القسم تقبل الآن حتى ${fmtDate(lang, closes!)}`,
              `${count(lang, open.length, N.program)} open until ${fmtDate(lang, closes!)}`,
            )}
          </span>
          <a
            href={`${PORTAL}/apply`}
            class="ms-auto rounded-lg bg-accent px-4 py-2 font-semibold text-on-primary hover:bg-accent-hover"
          >
            {t(lang, "apply")}
          </a>
        </div>
      )}
      <h2 class="font-display text-2xl font-bold">{t(lang, "programs")}</h2>
      {d.programs.length > 0 ? (
        <ul class="mt-4 divide-y divide-border-soft overflow-hidden rounded-2xl border border-border-soft bg-surface">
          {d.programs.map((p) => (
            <ProgramRow lang={lang} program={p} />
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-text-muted">
          {L("لا برامج منشورة في القسم بعد.", "No programmes published yet.")}
        </p>
      )}
      {faculty.length > 0 && (
        <section aria-labelledby="faculty" class="mt-10">
          <h2 id="faculty" class="font-display text-2xl font-bold">
            {L("هيئة التدريس", "Faculty")}
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {faculty.map((m, i) => (
              <li
                data-reveal
                style={`--i:${i}`}
                class="flex items-center gap-3 rounded-2xl border border-border-soft bg-surface p-4"
              >
                <span
                  aria-hidden="true"
                  class="grid size-11 shrink-0 place-items-center rounded-full bg-primary-soft font-bold text-primary-700"
                >
                  {initial(pick(lang, m.name_ar, m.name_en))}
                </span>
                <span class="min-w-0">
                  <b class="block text-text">{pick(lang, m.name_ar, m.name_en)}</b>
                  <span class="text-sm text-text-muted">
                    {[pick(lang, m.title_ar, m.title_en), ROLE[m.role]].filter(Boolean).join(" · ")}
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {news.length > 0 && (
        <section aria-labelledby="news" class="mt-10">
          <h2 id="news" class="font-display text-2xl font-bold">
            {L("أخبار القسم", "Department news")}
          </h2>
          <ul class="mt-4 space-y-3">
            {news.map((n) => (
              <li class="rounded-2xl border border-border-soft bg-surface p-4">
                {n.publish_at && (
                  <p class="text-xs text-text-muted">{fmtDate(lang, n.publish_at)}</p>
                )}
                <h3 class="mt-1 font-bold text-text">{n.title}</h3>
                <ArabicOnly lang={lang} when={isArabic(n.body)} class="mt-2">
                  <div class="space-y-2 text-sm leading-7 text-text-muted" set:html={n.body} />
                </ArabicOnly>
              </li>
            ))}
          </ul>
        </section>
      )}
      <a
        href={href(lang, "contact/")}
        class="mt-8 flex items-center justify-between gap-3 rounded-2xl bg-bg-subtle p-4 text-sm font-semibold text-primary"
      >
        {L(`لديك سؤال عن قسم ${name}؟ تواصل معنا`, `A question about ${name}? Contact us`)}
        <span aria-hidden="true">{arrow(lang)}</span>
      </a>
    </div>
    <Fragment slot="aside">
      {others.length > 0 && (
        <SideLinks lang={lang} title={L("أقسام أخرى", "Other departments")} links={others} />
      )}
    </Fragment>
  </WithAside>
</Base>
