---
import PageHead from "../../../components/PageHead.astro";
import Base from "../../../layouts/Base.astro";
import { departments } from "../../../lib/api";
import { type Lang, href, langPaths, num, pick, t } from "../../../lib/i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const depts = await departments();
const programs = depts.reduce((n, d) => n + d.programs.length, 0);
const teachers = depts.reduce((n, d) => n + d.teachers, 0);
const lead =
  lang === "ar"
    ? `${num(lang, depts.length)} أقسام أكاديمية · ${num(lang, programs)} برنامجًا · ${num(lang, teachers)} عضو هيئة تدريس`
    : `${depts.length} departments · ${programs} programs · ${teachers} faculty`;
---

<Base lang={lang} title={t(lang, "departments")} path="departments/">
  <PageHead
    lang={lang}
    title={t(lang, "departments")}
    lead={lead}
    crumbs={[[t(lang, "departments"), "departments/"]]}
  />
  <div class="mx-auto grid max-w-6xl gap-4 px-4 py-10 md:grid-cols-2 lg:px-8">
    {depts.map((d) => (
      <a
        href={href(lang, `departments/${d.code}/`)}
        class="block rounded-2xl border border-border-soft bg-surface p-5 hover:shadow-md"
      >
        <span class="inline-grid size-11 place-items-center rounded-xl bg-primary-soft text-sm font-bold text-primary-700">
          {d.code}
        </span>
        <h2 class="mt-3 font-display text-xl font-bold">{pick(lang, d.name_ar, d.name_en)}</h2>
        {d.description && <p class="mt-2 text-sm leading-6 text-text-muted">{d.description}</p>}
        <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs text-text-muted">
          <span>
            <b class="block text-lg text-text">{num(lang, d.programs.length)}</b>
            {t(lang, "programs")}
          </span>
          <span>
            <b class="block text-lg text-text">{num(lang, d.teachers)}</b>
            {t(lang, "teachers")}
          </span>
          <span>
            <b class="block text-lg text-text">{num(lang, d.students)}</b>
            {t(lang, "students")}
          </span>
        </div>
        {d.manager && (
          <p class="mt-4 border-t border-border-soft pt-3 text-xs text-text-muted">
            {t(lang, "manager")} · <b class="text-text">{d.manager}</b>
          </p>
        )}
      </a>
    ))}
  </div>
</Base>
