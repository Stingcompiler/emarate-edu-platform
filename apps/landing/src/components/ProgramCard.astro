---
import { PORTAL, type Program } from "../lib/api";
import {
  arrow,
  degree,
  fmtDate,
  href,
  type Lang,
  num,
  pick,
  t,
  years,
  count,
  N,
} from "../lib/i18n";

interface Props {
  lang: Lang;
  program: Program;
}
const { lang, program: p } = Astro.props;
const open = !!p.intake?.accepting;
---

<article
  class="flex h-full flex-col rounded-2xl border border-border-soft bg-surface p-4 shadow-sm"
  data-degree={p.degree}
  data-open={open ? "1" : "0"}
>
  <p class="text-xs font-semibold text-accent">
    {pick(lang, p.department_name, p.department_name_en)}
  </p>
  <h3 class="mt-1 text-base font-bold text-text">
    <a href={href(lang, `programs/${p.code}/`)} class="hover:text-primary">
      {pick(lang, p.name_ar, p.name_en)}
    </a>
  </h3>
  <p class="mt-1 text-xs text-text-muted">
    {years(lang, p.duration_terms)}
    {p.credit_hours ? ` · ${count(lang, p.credit_hours, N.hour)}` : ""} ·{" "}
    {degree(lang, p.degree, p.degree_label)}
  </p>
  <div class="mt-auto flex items-center justify-between gap-2 pt-4">
    {open ? (
      <span class="rounded-full bg-success-soft px-2.5 py-0.5 text-[11px] font-semibold text-success-strong">
        {t(lang, "open")} · {fmtDate(lang, p.intake!.closes_at, { day: "numeric", month: "short" })}
      </span>
    ) : (
      <span class="rounded-full bg-neutral-soft px-2.5 py-0.5 text-[11px] font-semibold text-neutral-strong">
        {t(lang, "closed")}
      </span>
    )}
    {open && (
      <a
        href={`${PORTAL}/apply?program=${encodeURIComponent(p.code)}`}
        class="text-xs font-semibold text-primary"
      >
        {t(lang, "apply")} {arrow(lang)}
      </a>
    )}
  </div>
</article>
