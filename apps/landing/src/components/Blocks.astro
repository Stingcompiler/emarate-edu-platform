---
import type { Block } from "../lib/api";

interface Props {
  blocks: Block[];
  /** «عرض الصور» from the page editor: consecutive images one per row, or side by side. */
  layout?: "single" | "grid";
}
const { blocks, layout = "single" } = Astro.props;

// In a grid, a run of consecutive images becomes one group; everything else stays a block.
type Item = Block | { type: "images"; items: Block[] };
const items: Item[] = [];
for (const b of blocks) {
  const last = items[items.length - 1];
  if (layout === "grid" && b.type === "image" && b.url) {
    if (last?.type === "images") last.items.push(b);
    else items.push({ type: "images", items: [b] });
  } else items.push(b);
}
---

<div class="prose-site space-y-4 text-base leading-8 text-text">
  {items.map((b) =>
    b.type === "images" ? (
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
        {b.items.map((img) => (
          <img
            data-reveal="image"
            src={img.url}
            alt={img.alt ?? ""}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-xl object-cover"
          />
        ))}
      </div>
    ) : b.type === "heading" ? (
      <h2 class="pt-2 font-display text-2xl font-bold">{b.text}</h2>
    ) : b.type === "paragraph" ? (
      <p class="whitespace-pre-line">{b.text}</p>
    ) : b.type === "note" ? (
      <p
        role="note"
        class="whitespace-pre-line rounded-xl border border-warning/40 bg-warning-soft px-4 py-3 text-sm leading-7 text-text"
      >
        {b.text}
      </p>
    ) : b.type === "html" ? (
      <div set:html={b.html} />
    ) : b.type === "image" && b.url ? (
      // Capped in height and centred: a portrait (the dean's photo) at the column's full
      // width stood taller than the screen; a landscape picture still fills the column.
      <img
        data-reveal="image"
        src={b.url}
        alt={b.alt ?? ""}
        loading="lazy"
        decoding="async"
        class="mx-auto block h-auto max-h-[min(55vh,32rem)] w-auto max-w-full rounded-2xl"
      />
    ) : b.type === "cta" && b.url ? (
      <a
        href={b.url}
        class="inline-flex rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-primary hover:bg-accent-hover"
      >
        {b.text}
      </a>
    ) : b.type === "list" && b.items ? (
      <ul class="list-disc space-y-1 ps-6">
        {b.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : null,
  )}
</div>
