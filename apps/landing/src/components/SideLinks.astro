---
import type { Lang } from "../lib/i18n";
import { arrow } from "../lib/i18n";

/** A titled list of links for a page's side column. */
interface Props {
  lang: Lang;
  title: string;
  links: { label: string; href: string; meta?: string; current?: boolean }[];
}
const { lang, title, links } = Astro.props;
---

{links.length > 0 && (
  <nav aria-label={title} class="rounded-2xl border border-border-soft bg-surface p-2">
    <p class="px-3 pb-1 pt-2 text-xs font-semibold text-text-muted">{title}</p>
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={l.current ? "page" : undefined}
        class:list={[
          "flex items-center justify-between gap-3 rounded-md px-3 py-2.5 text-sm hover:bg-surface-alt",
          l.current ? "bg-surface-alt font-semibold text-primary" : "text-text",
        ]}
      >
        <span class="min-w-0">
          <span class="block">{l.label}</span>
          {l.meta && <span class="block text-xs text-text-muted">{l.meta}</span>}
        </span>
        {!l.current && (
          <span aria-hidden="true" class="text-text-muted">
            {arrow(lang)}
          </span>
        )}
      </a>
    ))}
  </nav>
)}
