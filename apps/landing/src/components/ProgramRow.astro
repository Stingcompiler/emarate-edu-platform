---
import { PORTAL, type Program } from "../lib/api";
import { fold } from "../lib/fold";
import { count, degree, fmtDate, href, type Lang, N, pick, years } from "../lib/i18n";

/**
 * A programme row for long lists (board VisitorPrograms). UX review 2026-11-04: the name and
 * what the study is (duration, degree, hours) come first and read easily; the code steps
 * back; the state («التقديم مفتوح») and the action («قدّم الآن») are two things, no longer
 * one green link that looked like a badge.
 */
interface Props {
  lang: Lang;
  program: Program;
}
const { lang, program: p } = Astro.props;
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const open = !!p.intake?.accepting;
const name = pick(lang, p.name_ar, p.name_en);
---

<li
  class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3.5"
  data-degree={p.degree}
  data-open={open ? "1" : "0"}
  data-department={p.department_code}
  data-search={fold(`${p.code} ${p.name_ar} ${p.name_en}`)}
>
  <span class="min-w-0 flex-1 basis-56">
    <a
      href={href(lang, `programs/${p.code}/`)}
      class="block font-semibold leading-snug text-text hover:text-primary"
    >
      {name}
    </a>
    <span class="mt-0.5 block text-sm text-text">
      {degree(lang, p.degree, p.degree_label)} · {years(lang, p.duration_terms)}
      {p.credit_hours ? ` · ${count(lang, p.credit_hours, N.hour)}` : ""}
      <span class="text-text-muted">
        {" · "}
        <bdi dir="ltr" class="font-mono text-xs">
          {p.code}
        </bdi>
      </span>
    </span>
  </span>
  <span class="flex shrink-0 items-center gap-2">
    {open ? (
      <>
        <span class="rounded-full bg-success-soft px-2.5 py-1 text-xs font-semibold text-success-strong">
          {L("التقديم مفتوح", "Open")}
          <span class="hidden sm:inline">
            {" "}
            {L("حتى", "until")}{" "}
            {fmtDate(lang, p.intake!.closes_at, { day: "numeric", month: "short" })}
          </span>
        </span>
        <a
          href={`${PORTAL}/apply?program=${encodeURIComponent(p.code)}`}
          class="inline-flex min-h-10 items-center rounded-lg bg-accent px-3 text-xs font-semibold text-on-primary hover:bg-accent-hover"
          aria-label={`${L("قدّم الآن", "Apply now")} — ${name}`}
        >
          {L("قدّم الآن", "Apply now")}
        </a>
      </>
    ) : (
      <span class="rounded-full bg-neutral-soft px-2.5 py-1 text-xs font-semibold text-neutral-strong">
        {L("التقديم مغلق", "Closed")}
      </span>
    )}
  </span>
</li>
