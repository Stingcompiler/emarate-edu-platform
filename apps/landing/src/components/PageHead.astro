---
import { type Lang, href, t } from "../lib/i18n";

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  crumbs?: [string, string][];
}
const { lang, title, lead, crumbs = [] } = Astro.props;
---

<div class="border-b border-border-soft bg-bg-subtle">
  <div class="mx-auto max-w-6xl px-4 py-8 lg:px-8 lg:py-12">
    <nav class="text-xs text-text-muted" aria-label={lang === "ar" ? "مسار الصفحة" : "Breadcrumb"}>
      <a href={href(lang)} class="hover:text-text">
        {t(lang, "home")}
      </a>
      {crumbs.map(([label, path]) => (
        <>
          <span class="mx-1">/</span>
          <a href={href(lang, path)} class="hover:text-text">
            {label}
          </a>
        </>
      ))}
    </nav>
    <h1 class="mt-2 font-display text-3xl font-bold leading-snug text-text lg:text-4xl">{title}</h1>
    {lead && <p class="mt-3 max-w-2xl text-base leading-7 text-text-muted">{lead}</p>}
    <slot />
  </div>
</div>
