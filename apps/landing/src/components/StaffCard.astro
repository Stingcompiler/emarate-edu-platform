---
// A staff member's card (owner, 2026-10-30): photo, name, title, department and highest degree;
// the whole card opens their page. Used on the home page and the «الكوادر» page.
import type { StaffMember } from "../lib/api";
import { type Lang, href, pick } from "../lib/i18n";
import { DEGREE_EN, ROLE_LABEL, initialOf } from "../lib/staff";

interface Props {
  lang: Lang;
  member: StaffMember;
  index?: number;
}
const { lang, member: m, index = 0 } = Astro.props;
const name = pick(lang, m.name_ar, m.name_en);
const role = ROLE_LABEL[m.role]?.[lang] ?? "";
const top = (m.qualifications ?? [])[0];
const where = m.departments.map((d) => pick(lang, d.name_ar, d.name_en)).join(" · ");
---

<a
  data-reveal
  style={`--i:${index}`}
  href={href(lang, `staff/${m.id}/`)}
  class="motion-lift flex h-full flex-col rounded-2xl border border-border-soft bg-surface p-4"
>
  <span class="flex items-center gap-3">
    {m.photo ? (
      <img
        src={m.photo}
        alt=""
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        class="size-16 shrink-0 rounded-full bg-surface-alt object-cover"
      />
    ) : (
      // ui-allow: initials avatar
      <span
        aria-hidden="true"
        class="grid size-16 shrink-0 place-items-center rounded-full bg-primary-soft text-xl font-bold text-primary-700"
      >
        {initialOf(name)}
      </span>
    )}
    <span class="min-w-0">
      <b class="block text-text">{name}</b>
      <span class="block text-sm text-text-muted">
        {[pick(lang, m.title_ar, m.title_en), role].filter(Boolean).join(" · ")}
      </span>
    </span>
  </span>
  <span class="mt-3 block border-t border-border-soft pt-3 text-xs text-text-muted">{where}</span>
  {top && (
    <span class="mt-1 block text-sm text-text">
      {lang === "ar" ? top.degree_ar : (DEGREE_EN[top.degree] ?? top.degree_ar)}{" "}
      {lang === "ar" ? "في" : "in"} {top.field}
    </span>
  )}
</a>
