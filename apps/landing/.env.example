# Public website build (Astro SSG). Pages are built from the API at build time.
PUBLIC_API_URL=https://api.ecst.edu.sd        # the Django API (also used by the contact form in browsers)
PUBLIC_PORTAL_URL=https://portal.ecst.edu.sd  # "Apply", "Track", "Sign in" links
SITE_BUILD_TOKEN=                             # same value as the API's SITE_BUILD_TOKEN (build-time only)
LANDING_STRICT=1                              # fail the build if the API is down (never publish an empty site)
